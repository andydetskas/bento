---
// The card's masthead: globe runner, name and role. Shared by the bento card and the site card,
// so a hand-off between them lands on the same pixels.
import data from '../content/links.json';
import Icon from './Icon.astro';

interface Props {
  /** The name is the page's h1, except where the page has its own (a closer-look page). Type
      comes from the classes, so either element renders the same pixels. */
  nameAs?: 'h1' | 'p';
  /** Make the masthead a link (the site's hero links home). The link wraps only the name and
      stretches over the globe and role, so the layout, and the bento's pixels, don't change. */
  href?: string;
}
const { nameAs: Name = 'h1', href } = Astro.props;
const { profile } = data;
---

<header class:list={['card-head', { 'is-link': !!href }]}>
  <Icon name={profile.mark} class="mark" />
  <div class="who">
    <Name class="name line trim-sans"><span class="line-inner" style="--i:0">{href ? <a class="head-link" href={href} aria-label={`${profile.name}, home`}>{profile.name}</a> : profile.name}</span></Name>
    <p class="role line trim-mono"><span class="line-inner" style="--i:1">{profile.role}</span></p>
  </div>
</header>

<style>
  /* Type is trimmed to cap height and baseline (see .trim-* in global.css), and every cap
     height is a multiple of 4px, so the mark can match the text block exactly. */
  .card-head {
    --name-cap: round(var(--type-title) * var(--cap-sans), var(--bl));
    --role-cap: 8px;
    /* 12px between name and role (Andy, Nov 23: 8px read tight). The letters themselves sit
       about 10.5px apart, since the name's round letters dip below its baseline. */
    --who-gap: var(--space-3);
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }
  /* The globe runs from the name's cap height to the role's baseline. The script below
     re-measures if the role wraps onto a second line. */
  .card-head :global(.mark) {
    height: calc(var(--name-cap) + var(--who-gap) + var(--role-cap));
    aspect-ratio: 918 / 862;
    flex: none;
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: var(--who-gap);
    min-width: 0;
  }
  .name {
    --cap: var(--name-cap);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-title);
  }
  /* Linked masthead: the whole masthead is the hit area; no hover change (the hero has no
     mouseovers), keyboard focus outlines it. */
  .card-head.is-link {
    position: relative;
  }
  .head-link {
    color: inherit;
    text-decoration: none;
    outline: none;
  }
  .head-link::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: var(--space-2);
  }
  .head-link:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .role {
    --cap: var(--role-cap);
    --lh: var(--leading-eyebrow);
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>

<script>
  // Globe height = name cap height → role baseline, re-measured if the role wraps. The baseline
  // is measured, not taken from the trimmed box: the trim approximates the font's descent and
  // leaves the box bottom about a pixel under the real baseline, which put the globe's right foot
  // below "EXECUTION" (Andy, Nov 23). A zero-size probe after the role's inline-block sits on its
  // last line's baseline; it's outside the sliding .line-inner, so the entrance doesn't move it.
  const who = document.querySelector<HTMLElement>('.card-head .who');
  const mark = document.querySelector<HTMLElement>('.card-head .mark');
  const roleText = who?.querySelector<HTMLElement>('.role');
  if (who && mark) {
    const baseline = () => {
      if (!roleText) return who.getBoundingClientRect().bottom;
      const probe = document.createElement('span');
      probe.style.cssText = 'display:inline-block;width:0;height:0;vertical-align:baseline';
      roleText.appendChild(probe);
      const y = probe.getBoundingClientRect().top;
      probe.remove();
      return y;
    };
    const fitMark = () => (mark.style.height = `${baseline() - who.getBoundingClientRect().top}px`);
    fitMark();
    document.fonts?.ready.then(fitMark);
    window.addEventListener('resize', fitMark, { passive: true });
    new ResizeObserver(fitMark).observe(who);
  }
</script>
