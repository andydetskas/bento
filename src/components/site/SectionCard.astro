---
// A section of the site as a card. Closed, it shows a summary and the whole card is a link to the
// section's own page (/site/techniques/ and so on). Open, it takes over the work area (the right
// two columns on desktop, the right column on tablet; in place on phones) and shows its panel,
// with a Back pill at its top like the closer looks (Andy). The hero stays put. On the page, the
// script opens the card in place as a new history entry, so the browser's Back closes it too;
// without the script, the links load the section's page (rendered open) and the grid.
// Element ids are card-<id>, so the browser's own jump-to-anchor never fights the takeover.
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  /** Accent color (hex): arrow, pill and scene tint. None = neutral. */
  accent?: string;
  /** Pill text while closed. */
  pill?: string;
  /** Landing order (stagger). */
  index: number;
  /** This section's page, and the grid's (where the title links while the card is open). */
  href: string;
  closeHref: string;
  /** Page title while open. */
  pageTitle: string;
  /** Render open (the section's own page). */
  open?: boolean;
}
const { id, eyebrow, title, accent, pill, index, href, closeHref, pageTitle, open = false } = Astro.props;
// On a section's own page the open card's title is the page's h1 (the hero's name steps down to a p).
const Title = open ? 'h1' : 'h2';
const arrow = 'M7 17 17 7M9 7h8v8';
---

<section
  class:list={['card box is-takeover', `area-${id}`, { 'is-neutral': !accent, 'is-open': open }]}
  id={`card-${id}`}
  data-section={id}
  data-expandable
  data-href={href}
  data-page-title={pageTitle}
  data-accent={accent}
  data-pill={open ? undefined : pill}
  data-pill-closed={pill}
  aria-labelledby={`${id}-title`}
  style={`${accent ? `--accent:${accent};` : ''}--b:${index};view-transition-name:box-${id}`}
>
  <a class="backlink box-back" href={closeHref} aria-label="Back to all sections">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5M11 6l-6 6 6 6" />
    </svg>
    Back
  </a>
  <div class="box-top">
    <p class="eyebrow">{eyebrow}</p>
    <span class="arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d={arrow} />
      </svg>
    </span>
  </div>
  <Title class="box-title" id={`${id}-title`}>
    <a class="box-hit" href={open ? closeHref : href} aria-expanded={String(open)} aria-controls={`${id}-panel`}>
      {title}
    </a>
  </Title>
  <div class="box-summary">
    <slot name="summary" />
  </div>
  <div class="box-panel" id={`${id}-panel`} hidden={!open}>
    <slot name="panel" />
  </div>
</section>
