---
// Runs before first paint on every main-site page. Two ways to arrive mid-story:
//   From the bento (links. subdomain): a short-lived cookie carries the scene's clock, and the
//     site plays its arrival choreography (html.from-handoff; see src/lib/handoff.ts).
//   From another site page (Selected work → a closer look, Back, a section page): the scene
//     picks up where the last page left it, and the page shows at once with no intro
//     (html.from-site). The last page leaves its scene clock in sessionStorage on pagehide
//     (lib/site-shell.ts rememberScene). A reload plays the full entrance again.
//     When Back or Forward restores a page from the back/forward cache, nothing here runs;
//     rememberScene's pageshow handler picks up the clock in that case.
import { HANDOFF_COOKIE, HANDOFF_MAX_AGE_S } from '../../lib/handoff';
import { SITE_SCENE_KEY } from '../../lib/site-shell';
import { DARK_PALETTE, DISPLAY_KEY } from '../../lib/display-settings';
---

<script is:inline define:vars={{ name: HANDOFF_COOKIE, maxAge: HANDOFF_MAX_AGE_S, sceneKey: SITE_SCENE_KEY, displayKey: DISPLAY_KEY, darkPalette: DARK_PALETTE }}>
  const root = document.documentElement;
  // Display settings saved on this device (lib/display-settings.ts), applied before first paint so
  // text size, contrast and motion never flash. Only non-default values are stored.
  try {
    const d = JSON.parse(localStorage.getItem(displayKey) || '{}');
    for (const k in d) if (typeof d[k] === 'string' && /^[a-z]+$/.test(k)) root.dataset[k] = d[k];
  } catch {}
  // Theme: dark if chosen here, or if nothing is chosen and the device is dark. The tokens follow
  // data-mode; the page behind the cards and the scene (window.__scenePalette, read by
  // ShapeField when it boots) switch to Adobe Night, so nothing paints light first.
  try {
    const t = root.dataset.theme;
    if (t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)) {
      root.dataset.mode = 'dark';
      root.style.setProperty('--scene-bg', darkPalette.bg);
      root.style.background = darkPalette.bg;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', darkPalette.bg);
      window.__scenePalette = darkPalette;
    }
  } catch {}
  const m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
  if (m) {
    const domain = location.hostname.endsWith('andydetskas.com') ? '; Domain=andydetskas.com' : '';
    document.cookie = name + '=; Max-Age=0; Path=/; SameSite=Lax' + domain;
    try {
      const h = JSON.parse(decodeURIComponent(m[1]));
      if (h.v === 1 && Date.now() - h.at < maxAge * 1000) {
        window.__handoff = h;
        root.classList.add('from-handoff');
      }
    } catch {}
  }
  // A cross-document view transition from another site page: the scene gets a layer of its own,
  // so the last page's frame holds under this page's scene until it's showing (site.css holds it,
  // lib/site-shell.ts lets go). Set here because pagereveal fires before first paint. It fires again
  // when Back or Forward restores the page from the back/forward cache.
  addEventListener('pagereveal', (e) => {
    // Motion off (system or Display settings): arrive without the cross-page transition.
    if (e.viewTransition && (root.dataset.motion === 'reduced' || matchMedia('(prefers-reduced-motion: reduce)').matches)) {
      e.viewTransition.skipTransition();
      return;
    }
    const vt = e.viewTransition;
    const canvas = document.querySelector('canvas.scene');
    if (!vt || !canvas) return;
    canvas.style.viewTransitionName = 'scene';
    root.classList.remove('scene-arrived');
    root.classList.add('page-transition');
    window.__sceneHeld = true;
    document.dispatchEvent(new Event('site:pagereveal'));
    vt.finished.finally(() => {
      canvas.style.viewTransitionName = '';
      root.classList.remove('scene-arrived', 'page-transition');
      window.__sceneHeld = false;
    });
  });
  if (!window.__handoff) {
    try {
      const nav = performance.getEntriesByType('navigation')[0];
      const s = JSON.parse(sessionStorage.getItem(sceneKey) || 'null');
      sessionStorage.removeItem(sceneKey);
      if (s && s.v === 1 && Date.now() - s.at < 10000 && (!nav || nav.type !== 'reload')) {
        window.__handoff = s;
        root.classList.add('from-site', 'is-ready', 'is-landing', 'is-settled');
      }
    } catch {}
  }
</script>
