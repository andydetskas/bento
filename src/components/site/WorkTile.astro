---
// A case study inside the Portfolio panel: art, company and my role, title, summary and the public
// outcome. The role rides in the eyebrow (Andy dropped the separate My role row, which made the
// tiles uneven), so it still sits next to every outcome. The whole tile links to the work's closer-look page when it has one (public, same
// tab), otherwise to the full, passcode-protected case study.
import site from '../../content/site.json';
import { tokens } from '../../lib/tokens';

type Work = (typeof site.work)[number];
interface Props {
  item: Work;
}
const { item } = Astro.props;
const accent = (tokens.accent as Record<string, string>)[item.accent];
const [hue, step] = item.tint as [string, string];
const tint = (tokens.taos.light as Record<string, Record<string, string>>)[hue][step];
const outcome = 'outcome' in item ? item.outcome : undefined;
const look = 'look' in item ? item.look : undefined;
---

<article class="tile" style={`--accent:${accent};--tint:${tint}`}>
  <div class="work-art" data-fit={item.fit}>
    <img src={item.image.src} width={item.image.width} height={item.image.height} alt={item.image.alt} loading="lazy" decoding="async" />
  </div>
  <p class="eyebrow">{item.company} · {item.roleShort}</p>
  <h3 class="tile-title">
    {
      look ? (
        <a href={look} data-accent={accent} data-pill="A closer look">
          {item.title}
        </a>
      ) : (
        <a href={item.url} target="_blank" rel="noopener noreferrer" data-accent={accent} data-pill="Full case study · passcode">
          {item.title}
          <span class="sr-only">(full case study, opens in a new tab, passcode required)</span>
        </a>
      )
    }
  </h3>
  <p class="box-body">{item.summary}</p>
  {outcome && <p class="outcome">{outcome}</p>}
</article>
