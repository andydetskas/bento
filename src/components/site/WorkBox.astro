---
// A case study as a box. Click (or Enter) opens it in place: the box spans the work column and
// shows my role and the public outcome, with a link to the full, passcode-protected case study.
import site from '../../content/site.json';
import { tokens } from '../../lib/tokens';

type Work = (typeof site.work)[number];
interface Props {
  item: Work;
  /** Landing order (stagger). */
  index: number;
}
const { item, index } = Astro.props;
const accent = (tokens.accent as Record<string, string>)[item.accent];
const [hue, step] = item.tint as [string, string];
const tint = (tokens.taos.light as Record<string, Record<string, string>>)[hue][step];
const panelId = `${item.id}-panel`;
const outcome = 'outcome' in item ? item.outcome : undefined;
---

<article
  class:list={['card box work', { 'is-wide': 'featured' in item && item.featured }]}
  id={item.id}
  data-expandable
  data-accent={accent}
  data-pill="Open the summary"
  data-pill-open="Close"
  style={`--accent:${accent};--tint:${tint};--b:${index};view-transition-name:box-${item.id}`}
>
  <div class="box-top">
    <p class="eyebrow">{item.company}</p>
    <span class="arrow" aria-hidden="true">
      <svg class="i-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8" /></svg>
      <svg class="i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M7 7l10 10M17 7 7 17" /></svg>
    </span>
  </div>

  <div class="work-body">
    <div class="work-art" data-fit={item.fit}>
      <img src={item.image.src} width={item.image.width} height={item.image.height} alt={item.image.alt} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
    </div>
    <div class="work-text">
      <h2 class="box-title">
        <button class="box-hit" type="button" aria-expanded="false" aria-controls={panelId}>{item.title}</button>
      </h2>
      <p class="box-body">{item.summary}</p>
      <div class="work-panel" id={panelId} hidden>
        <dl class="facts">
          <dt>My role</dt>
          <dd>{item.role}</dd>
        </dl>
        {outcome && <p class="outcome">{outcome}</p>}
        <a class="btn" href={item.url} target="_blank" rel="noopener noreferrer" data-pill="Passcode required">
          Read the full case study
          <span class="sr-only">(opens in a new tab; passcode required)</span>
        </a>
      </div>
    </div>
  </div>
</article>
