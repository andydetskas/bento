---
// The site's hero card: the bento card, grown up. Same masthead in the same spot (top-left, one
// gutter in, one site column wide), so the bento's exit, the card folded to its masthead, is
// this card's first frame. Below the masthead: the positioning line, the site's menu (HeroMenu,
// with Display settings as its last row) and the call to action (Andy, Nov 16: the line under the
// headline went, and LinkedIn moved to About). The masthead links home (Andy). No pills, scene tint
// or row dimming here (Andy); the menu rows have a hover of their own (Nov 17). Keyboard focus shows.
import links from '../../content/links.json';
import site from '../../content/site.json';
import CardHead from '../CardHead.astro';
import HeroMenu from './HeroMenu.astro';
import { SITE_BASE, CALL_PATH } from '../../lib/site-sections';

interface Props {
  /** See CardHead: 'p' on pages with their own h1. */
  nameAs?: 'h1' | 'p';
  /** The menu row for this page (HeroMenu). */
  current?: 'work' | 'techniques' | 'leadership' | 'about' | null;
}
const { nameAs = 'h1', current = 'work' } = Astro.props;
const { intro } = site;
// Resume and email live on About (Andy, Nov 11). Here, email is the quiet button beside the call
// to action, so it's in two places on the site.
const email = intro.contact.find((c) => c.url.startsWith('mailto:'))!;
---

<section class="card site-card area-hero" aria-label={`${links.profile.name}, about`} style="view-transition-name:box-hero">
    <CardHead nameAs={nameAs} href={SITE_BASE} />
    <div class="card-more">
      <div class="card-more-inner">
        <p class="headline">{intro.headline}</p>
        <HeroMenu current={current} />

        <div class="cta-row">
          <a class="btn btn-quiet" href={email.url}>{intro.emailCta}</a>
          <a class="btn" href={CALL_PATH} target="_blank" rel="noopener noreferrer">
            {intro.cta.label}
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
</section>

<style>
  /* Bottom padding grows from the bento's (--pad-end) to the full --pad as the card opens. */
  .site-card {
    padding-bottom: var(--pad);
    transition:
      padding-bottom var(--motion-settle) var(--motion-ease-settle) 160ms,
      background-color var(--motion-base) var(--motion-ease-standard);
  }

  /* Collapsed to the masthead (the hand-off's first frame) until the cards land, then it opens.
     Open, it fills the card, so when the card stretches to a taller row, the call to action
     sits at the bottom (Andy) rather than under the menu with space below it. */
  .card-more {
    flex: 1 1 auto;
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows var(--motion-settle) var(--motion-ease-settle) 160ms;
  }
  .card-more-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    transition: opacity 480ms var(--motion-ease-standard) 140ms;
  }
  :global(html.js:not(.is-landing)) .site-card {
    padding-bottom: var(--pad-end);
  }
  :global(html.js:not(.is-landing)) .card-more {
    grid-template-rows: 0fr;
  }
  :global(html.js:not(.is-landing)) .card-more-inner {
    opacity: 0;
  }
  /* Once open, let focus rings out of the clip. */
  :global(html.is-settled) .card-more-inner {
    overflow: visible;
  }

  .headline {
    margin: 0;
    font-size: min(var(--step-3), 4.6svh);
    line-height: 1.08;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  /* ── Call to action ─────────────────────────────────── */
  /* One row (Andy): a quiet Email me button, then Schedule a call. They share the row's width,
     and stack only if the hero is too narrow for both. */
  .cta-row {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .cta-row .btn {
    flex: 1 1 auto;
    justify-content: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-card,
    .card-more,
    .card-more-inner {
      transition: none;
    }
  }
</style>
