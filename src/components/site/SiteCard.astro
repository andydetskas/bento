---
// The site's hero card: the bento card, grown up. Same masthead in the same spot (top-left, one
// gutter in, one site column wide), so the bento's exit, the card folded to its masthead, is
// this card's first frame. Below the masthead: the positioning line, the site's menu (HeroMenu,
// with Display settings as its last row) and the call to action (Andy, Nov 16: the line under the
// headline went, and LinkedIn moved to About). The masthead links home (Andy). No pills, scene tint
// or row dimming here (Andy); the menu rows have a hover of their own (Nov 17). Keyboard focus shows.
import links from '../../content/links.json';
import site from '../../content/site.json';
import CardHead from '../CardHead.astro';
import HeroMenu from './HeroMenu.astro';
import { SITE_BASE, CALL_PATH } from '../../lib/site-sections';

interface Props {
  /** See CardHead: 'p' on pages with their own h1. */
  nameAs?: 'h1' | 'p';
  /** The menu row for this page (HeroMenu). */
  current?: 'work' | 'techniques' | 'leadership' | 'about' | null;
  /** Inner pages (closer looks, section pages): on a phone the card folds to its masthead, with a
   *  menu button, so the page's own title is in the first screen (Andy, Nov 17). */
  fold?: boolean;
}
const { nameAs = 'h1', current = 'work', fold = false } = Astro.props;
const { intro } = site;
// Resume and email live on About (Andy, Nov 11). Here, email is the quiet button beside the call
// to action, so it's in two places on the site.
const email = intro.contact.find((c) => c.url.startsWith('mailto:'))!;
---

<section class:list={['card site-card area-hero', { 'can-fold': fold }]} aria-label={`${links.profile.name}, about`} style="view-transition-name:box-hero">
    <CardHead nameAs={nameAs} href={SITE_BASE} />
    {fold && (
      <button class="menu-toggle arrow" type="button" aria-expanded="false" aria-controls="site-card-more">
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
      </button>
    )}
    <div class="card-more" id="site-card-more">
      <div class="card-more-inner">
        <p class="headline">{intro.headline}</p>
        <HeroMenu current={current} />

        {/* Lately (Andy, Nov 23): three or four shipped things, no years and no contribution grid
            (market scan §5, Eric Greene's pattern). Under the menu, so the site's rows stay first. */}
        <section class="lately" aria-labelledby="lately-title">
          <h2 class="lately-title" id="lately-title">Lately</h2>
          <ul role="list">
            {intro.lately.map((l) => {
              const external = /^https?:/.test(l.url);
              return (
                <li>
                  <a href={l.url} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
                    <span class="lately-name">{l.label}</span>
                    <span class="lately-note">{l.note}</span>
                    {external && <span class="sr-only">(opens in a new tab)</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>

        <div class="cta-row">
          <a class="btn btn-quiet" href={email.url}>{intro.emailCta}</a>
          <a class="btn" href={CALL_PATH} target="_blank" rel="noopener noreferrer">
            {intro.cta.label}
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
</section>

<style>
  /* Bottom padding grows from the bento's (--pad-end) to the full --pad as the card opens. */
  .site-card {
    padding-bottom: var(--pad);
    transition:
      padding-bottom var(--motion-settle) var(--motion-ease-settle) 160ms,
      background-color var(--motion-base) var(--motion-ease-standard);
  }

  /* Collapsed to the masthead (the hand-off's first frame) until the cards land, then it opens.
     Open, it fills the card, so when the card stretches to a taller row, the call to action
     sits at the bottom (Andy) rather than under the menu with space below it. */
  .card-more {
    flex: 1 1 auto;
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows var(--motion-settle) var(--motion-ease-settle) 160ms;
  }
  .card-more-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    transition: opacity 480ms var(--motion-ease-standard) 140ms;
  }
  :global(html.js:not(.is-landing)) .site-card {
    padding-bottom: var(--pad-end);
  }
  :global(html.js:not(.is-landing)) .card-more {
    grid-template-rows: 0fr;
  }
  :global(html.js:not(.is-landing)) .card-more-inner {
    opacity: 0;
  }
  /* Once open, let focus rings out of the clip. */
  :global(html.is-settled) .card-more-inner {
    overflow: visible;
  }

  .headline {
    margin: 0;
    font-size: min(var(--step-3), 4.6svh);
    line-height: 1.08;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  /* ── Lately ─────────────────────────────────────────── */
  /* A compact list: the name, then a one-line note in the muted color. Every word is visible text
     (no hover-only content); hover and focus underline the name. */
  .lately {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .lately-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: calc(12px * var(--text-scale, 1));
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .lately ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .lately a {
    display: block;
    color: inherit;
    text-decoration: none;
    font-size: var(--step--1);
    line-height: 1.35;
    text-wrap: pretty;
  }
  .lately-name {
    margin-right: 0.35em;
    font-weight: var(--weight-medium);
  }
  .lately-note {
    color: var(--color-text-muted);
  }
  .lately a:hover .lately-name,
  .lately a:focus-visible .lately-name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ── Call to action ─────────────────────────────────── */
  /* One row (Andy): a quiet Email me button, then Schedule a call. They share the row's width,
     and stack only if the hero is too narrow for both. */
  .cta-row {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .cta-row .btn {
    flex: 1 1 auto;
    justify-content: center;
  }

  /* ── Folded on a phone (inner pages) ────────────────── */
  /* One column: on a closer look or section page the card stays folded to its masthead, so the
     page's title, summary and role strip lead the first screen. The chevron opens the menu.
     Without JS the card stays open. */
  .menu-toggle {
    display: none;
  }
  @media (max-width: 759px) {
    :global(html.js .site.has-open) .site-card.can-fold {
      position: relative;
    }
    :global(html.js .site.has-open) .can-fold .menu-toggle {
      display: grid;
      position: absolute;
      top: var(--pad);
      right: var(--pad);
      width: 36px;
      height: 36px;
      padding: 0;
      background: none;
      cursor: pointer;
    }
    :global(html.js .site.has-open) .can-fold .menu-toggle svg {
      width: 16px;
      height: 16px;
      transition: rotate var(--motion-base) var(--motion-ease-settle);
    }
    :global(html.js .site.has-open) .can-fold.is-menu-open .menu-toggle svg {
      rotate: 180deg;
    }
    :global(html.js .site.has-open) .can-fold .menu-toggle:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 2px;
    }
    /* Room for the chevron beside the masthead. */
    :global(html.js .site.has-open) .can-fold :global(.card-head) {
      padding-right: 48px;
    }
    :global(html.js .site.has-open) .site-card.can-fold:not(.is-menu-open) {
      padding-bottom: var(--pad-end);
    }
    :global(html.js .site.has-open) .can-fold:not(.is-menu-open) .card-more {
      grid-template-rows: 0fr;
    }
    /* Folded, the menu is out of the tab order too (visibility), not just clipped. */
    :global(html.js .site.has-open) .can-fold:not(.is-menu-open) .card-more-inner {
      opacity: 0;
      visibility: hidden;
      overflow: hidden;
      transition:
        opacity 200ms var(--motion-ease-standard),
        visibility 0s linear 200ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-card,
    .card-more,
    .card-more-inner,
    .menu-toggle svg {
      transition: none;
    }
  }
</style>

<script>
  // The phone menu button on inner pages: opens and folds the card. While it's open, Escape folds
  // it and stops there: the page's own Escape (back from a closer look or section) waits for the
  // next press. Listened for on window, capture phase, so it runs before the page's handler.
  const card = document.querySelector<HTMLElement>('.site-card.can-fold');
  const toggle = card?.querySelector<HTMLButtonElement>('.menu-toggle');
  if (card && toggle) {
    const isOpen = () => card.classList.contains('is-menu-open');
    const set = (open: boolean) => {
      card.classList.toggle('is-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => set(!isOpen()));
    window.addEventListener(
      'keydown',
      (e) => {
        if (e.key !== 'Escape' || !isOpen() || getComputedStyle(toggle).display === 'none') return;
        e.stopPropagation();
        set(false);
        if (card.contains(document.activeElement)) toggle.focus();
      },
      true,
    );
  }
</script>
