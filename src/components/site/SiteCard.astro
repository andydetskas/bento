---
// The site's hero card: the bento card, grown up. Same masthead in the same spot (top-left, one
// gutter in, one site column wide), so the bento's exit, the card folded to its masthead, is
// this card's first frame. Below the masthead: the positioning line, follow links and the one
// call to action. The masthead links home (Andy). No mouseovers here (Andy): no pills, no scene
// tint, no row dimming. Keyboard focus still shows.
import links from '../../content/links.json';
import site from '../../content/site.json';
import { tokens } from '../../lib/tokens';
import CardHead from '../CardHead.astro';
import Icon from '../Icon.astro';
import { SITE_BASE } from '../../lib/site-sections';

interface Props {
  /** See CardHead: 'p' on pages with their own h1. */
  nameAs?: 'h1' | 'p';
}
const { nameAs = 'h1' } = Astro.props;
const { intro } = site;
const accents = tokens.accent as Record<string, string>;
const follow = intro.follow.map((id) => links.links.find((l) => l.id === id)!);
---

<section class="card site-card area-hero" aria-label={`${links.profile.name}, about`} style="view-transition-name:box-hero">
    <CardHead nameAs={nameAs} href={SITE_BASE} />
    <div class="card-more">
      <div class="card-more-inner">
        <p class="headline">{intro.headline}</p>
        <p class="sub">{intro.sub}</p>

        <ul class="follow" role="list">
          {
            follow.map((l) => (
              <li>
                <a
                  class="frow"
                  href={l.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  style={`--accent:${accents[l.id]}`}
                >
                  <Icon name={l.icon} class="frow-icon" />
                  <span class="frow-label">{l.label}</span>
                  <span class="frow-note">{l.eyebrow}</span>
                  <span class="arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17 17 7M9 7h8v8" />
                    </svg>
                  </span>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="cta-row">
          <p class="status"><span class="dot" aria-hidden="true"></span>{intro.status}</p>
          <a class="btn" href={intro.cta.url} target="_blank" rel="noopener noreferrer">
            {intro.cta.label}
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
</section>

<style>
  /* Bottom padding grows from the bento's (--pad-end) to the full --pad as the card opens. */
  .site-card {
    padding-bottom: var(--pad);
    transition:
      padding-bottom var(--motion-settle) var(--motion-ease-settle) 160ms,
      background-color var(--motion-base) var(--motion-ease-standard);
  }

  /* Collapsed to the masthead (the hand-off's first frame) until the cards land, then it opens.
     Open, it fills the card, so when the card stretches to a taller row, the call to action
     sits at the bottom (Andy) rather than under the follow rows with space below it. */
  .card-more {
    flex: 1 1 auto;
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows var(--motion-settle) var(--motion-ease-settle) 160ms;
  }
  .card-more-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    transition: opacity 480ms var(--motion-ease-standard) 140ms;
  }
  :global(html.js:not(.is-landing)) .site-card {
    padding-bottom: var(--pad-end);
  }
  :global(html.js:not(.is-landing)) .card-more {
    grid-template-rows: 0fr;
  }
  :global(html.js:not(.is-landing)) .card-more-inner {
    opacity: 0;
  }
  /* Once open, let focus rings out of the clip. */
  :global(html.is-settled) .card-more-inner {
    overflow: visible;
  }

  .headline {
    margin: 0;
    font-size: min(var(--step-3), 4.6svh);
    line-height: 1.08;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  .sub {
    margin: calc(var(--space-6) * -0.5) 0 0;
    font-size: var(--step-0);
    line-height: 1.4;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* ── Follow rows: the bento's rows, at a smaller size ── */
  .follow {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .follow li + li .frow {
    border-top: 1px solid var(--color-line);
  }
  .frow {
    display: grid;
    grid-template-columns: 20px auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    color: inherit;
    text-decoration: none;
    outline: none;
  }
  .frow :global(.frow-icon) {
    width: 20px;
    height: 20px;
  }
  .frow-label {
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-title);
  }
  .frow-note {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  /* Keyboard focus only: underline the label and fill the arrow (site.css). */
  .frow:focus-visible .frow-label {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--color-focus);
  }

  /* ── Call to action ─────────────────────────────────── */
  /* One row (Andy): the status beside the button. Where the hero is too narrow for both on one
     line, the status folds onto two short lines rather than dropping under the button. */
  .cta-row {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .cta-row .btn {
    flex: none;
  }
  .status {
    margin: 0;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    line-height: 1.35;
    text-wrap: balance;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--taos-light-verde-600);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--taos-light-verde-600) 22%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-card,
    .card-more,
    .card-more-inner {
      transition: none;
    }
  }
</style>
