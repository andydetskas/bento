---
// Main site prototype (andydetskas.com, "full" treatment). Cards over the bento's scene: the
// hero on the left, and in the right two columns Portfolio, Leadership / Techniques, About
// (which holds My working kit). The left column below the hero stays open so the scene shows.
// Opening Portfolio, Leadership, Techniques or About takes over the right two columns
// (Bohdana) and the hero stays put. Every section has its own URL (see lib/site-sections.ts);
// /site/ renders the grid and /site/techniques/ etc. render it with that card open.
// Lives under /site/ on the `site` branch; not linked or indexed.
import '../../styles/site.css';
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Pill from '../Pill.astro';
import ShapeField from '../ShapeField.astro';
import SectionCard from './SectionCard.astro';
import SiteCard from './SiteCard.astro';
import SiteHead from './SiteHead.astro';
import WorkTile from './WorkTile.astro';
import site from '../../content/site.json';
import { defaultPreset } from '../../lib/presets';
import { SITE_BASE, SITE_DESCRIPTION, SITE_TITLE, sectionById, sectionPath, type Section } from '../../lib/site-sections';
import { tokens } from '../../lib/tokens';

interface Props {
  /** The section to render open (its own page); none = the grid. */
  open?: Section['id'];
}
const { open } = Astro.props;
const current = open ? sectionById(open) : undefined;

const { portfolio, leadership, work, kit, techniques, about } = site;
const accent = tokens.accent as Record<string, string>;
const light = tokens.taos.light as Record<string, Record<string, string>>;
const byId = (id: string) => work.find((w) => w.id === id)!;
const tintOf = (w: (typeof work)[number]) => light[w.tint[0]][w.tint[1]];
const kitLabel = kit.title.replace(/\.$/, ''); // "My working kit"
const card = (id: Section['id']) => {
  const s = sectionById(id);
  return { href: sectionPath(s), closeHref: SITE_BASE, pageTitle: s.title, open: open === id };
};
const arrow = 'M7 17 17 7M9 7h8v8';
---

<Base title={current?.title ?? SITE_TITLE} description={current?.description ?? SITE_DESCRIPTION} preset={defaultPreset} noindex>
  <Fragment slot="head">
    {/* Before first paint: arriving from the bento or another site page? (see SiteHead) */}
    <SiteHead />
  </Fragment>

  <ShapeField preset={defaultPreset} eager />

  <main class:list={['site', { 'has-open': !!open }]} data-base={SITE_BASE} data-page-title={SITE_TITLE}>
    <SiteCard />

    <SectionCard id="portfolio" eyebrow={portfolio.eyebrow} title={portfolio.title} accent={accent.portfolio} pill="See the work" index={0} {...card('portfolio')}>
      <Fragment slot="summary">
        <div class="mosaic" aria-hidden="true">
          {portfolio.preview.map((id) => {
            const w = byId(id);
            return (
              <span class="mosaic-cell" data-fit={w.fit} style={`--tint:${tintOf(w)}`}>
                <img src={w.image.src} width={w.image.width} height={w.image.height} alt="" loading="eager" decoding="async" fetchpriority="low" />
              </span>
            );
          })}
        </div>
        <p class="box-body">{portfolio.lede}</p>
      </Fragment>
      <Fragment slot="panel">
        <p class="panel-lede">{portfolio.lede}</p>
        <div class="tiles work-tiles">
          {work.map((w) => <WorkTile item={w} />)}
        </div>
      </Fragment>
    </SectionCard>

    <SectionCard id="leadership" eyebrow={leadership.eyebrow} title={leadership.title} accent={accent.leadership} pill="How I lead" index={1} {...card('leadership')}>
      <Fragment slot="summary">
        <ul class="principles" role="list">
          {leadership.principles.map((p) => (
            <li>
              <strong>{p.title}</strong>
              <span>{p.body}</span>
            </li>
          ))}
        </ul>
      </Fragment>
      <Fragment slot="panel">
        <p class="panel-lede">{leadership.lede}</p>
        <ul class="principles principles-grid" role="list">
          {leadership.principles.map((p) => (
            <li>
              <strong>{p.title}</strong>
              <span>{p.body}</span>
            </li>
          ))}
        </ul>
        <ul class="stats stats-row" role="list">
          {leadership.stats.map((s) => (
            <li>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </li>
          ))}
        </ul>
        <div class="groups">
          {leadership.groups.map((g) => (
            <section class="group">
              <header>
                <h3>{g.org}</h3>
                <p class="eyebrow">{g.role}</p>
              </header>
              <ul role="list">
                {g.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </section>
          ))}
        </div>
      </Fragment>
    </SectionCard>

    <SectionCard id="techniques" eyebrow={techniques.eyebrow} title={techniques.title} accent={accent.techniques} pill="Read the techniques" index={2} {...card('techniques')}>
      <Fragment slot="summary">
        <p class="box-body">{techniques.lede}</p>
        {/* Each technique links to its article; hovering one hints what it's about. */}
        <ul class="post-list" role="list">
          {techniques.posts.map((p) => (
            <li>
              <a href={p.url} target="_blank" rel="noopener noreferrer" data-pill={p.note} data-accent={accent.techniques}>
                <Icon name={p.icon} />
                <span class="post-title">{p.title}</span>
                <svg class="post-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={arrow} />
                </svg>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </Fragment>
      <Fragment slot="panel">
        <p class="panel-lede">{techniques.lede}</p>
        <div class="tiles">
          {techniques.posts.map((p) => (
            <article class="tile">
              <div class="post-art">
                <img src={p.image} width="800" height="448" alt="" loading="lazy" decoding="async" />
              </div>
              <h3 class="tile-title">
                <a href={p.url} target="_blank" rel="noopener noreferrer" data-pill="Read the technique">
                  {p.title}
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </h3>
              <p class="box-body">{p.note}</p>
            </article>
          ))}
        </div>
      </Fragment>
    </SectionCard>

    <SectionCard id="about" eyebrow={about.eyebrow} title={about.title} accent={accent.about} pill="More about me" index={3} {...card('about')}>
      <Fragment slot="summary">
        <img class="about-photo" src={about.photo.src} width={about.photo.width} height={about.photo.height} alt={about.photo.alt} loading="eager" decoding="async" fetchpriority="low" />
        <p class="box-body">{about.body}</p>
        <div class="kit-inline">
          <p class="eyebrow">{kitLabel}</p>
          <p class="kit-names">{kit.tools.map((t) => t.name).join(' · ')}</p>
        </div>
      </Fragment>
      <Fragment slot="panel">
        <div class="about-panel">
          <div class="about-intro">
            <img class="about-photo" src={about.photo.src} width={about.photo.width} height={about.photo.height} alt={about.photo.alt} loading="lazy" decoding="async" />
            <div class="about-text">
              <p class="panel-lede">{about.body}</p>
              <p class="box-body">{about.more}</p>
            </div>
          </div>
          <section class="about-section" aria-labelledby="about-kit">
            <h3 id="about-kit">{kit.title}</h3>
            <p class="box-body">{kit.lede}</p>
            <ul class="kit-tools" role="list">
              {kit.tools.map((t) => (
                <li>
                  <strong>{t.name}</strong>
                  <span>{t.note}</span>
                </li>
              ))}
            </ul>
          </section>
          <section class="about-section" aria-labelledby="about-experience">
            <h3 id="about-experience">Experience</h3>
            <ul class="roles" role="list">
              {about.experience.map((x) => (
                <li>
                  <strong>{x.role}</strong>
                  {'org' in x && <span>{x.org}</span>}
                </li>
              ))}
            </ul>
          </section>
        </div>
      </Fragment>
    </SectionCard>
  </main>

  <Pill />
</Base>

<script>
  import { rememberScene, runEntrance, watchHeroHeight } from '../../lib/site-shell';

  rememberScene();
  const grid = document.querySelector<HTMLElement>('.site')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = window.matchMedia('(min-width: 760px)');
  const base = grid.dataset.base ?? '/';

  // ── Takeover ────────────────────────────────────────
  // One card open at a time. On tablet and desktop it takes over the work area and the other
  // work cards step out; on phones it opens in place. A same-document view transition moves
  // everything (browsers without it just switch). Opening a card adds a history entry with the
  // section's URL (/site/techniques/), so the browser's Back closes it and Forward opens it again,
  // as with a closer look (Andy). The card's Back pill steps back through history too when the
  // entry behind it is the grid, so the two Backs agree; on a section page reached directly, it
  // closes the card and adds the grid's entry instead. A new-tab click loads the section's page.
  interface Entry {
    site: 1;
    /** The open card's section, or null for the grid. */
    open: string | null;
    /** The entry behind this one is the grid, on this page. */
    back?: boolean;
    /** Scroll position, kept as the visitor scrolls. */
    y?: number;
  }
  const cards = [...document.querySelectorAll<HTMLElement>('[data-expandable]')];

  watchHeroHeight(grid);
  const openCard = () => cards.find((c) => c.classList.contains('is-open'));
  const state = (): Partial<Entry> => (history.state?.site === 1 ? history.state : {});
  const urlOf = (card?: HTMLElement) => (card ? card.dataset.href! : base) + location.search;
  const cardAt = (path: string) => cards.find((c) => new URL(c.dataset.href!, location.href).pathname === path);

  // Scroll is ours to put back: the view transition updates the page after the browser would have
  // restored it. Each entry keeps its own position; a reload, or a Back that reloads, gets it too.
  history.scrollRestoration = 'manual';
  let saveTimer = 0;
  const remember = () => {
    clearTimeout(saveTimer);
    history.replaceState({ ...state(), site: 1, y: Math.round(scrollY) }, '');
  };
  addEventListener('scroll', () => {
    clearTimeout(saveTimer);
    saveTimer = window.setTimeout(remember, 200);
  }, { passive: true });
  // And right before any link leaves (a closer look), in case the last scroll hasn't been saved.
  document.addEventListener('click', (e) => (e.target as Element).closest?.('a[href]') && remember(), true);

  const setOpen = (card: HTMLElement, open: boolean) => {
    const hit = card.querySelector<HTMLAnchorElement>('.box-hit')!;
    card.classList.toggle('is-open', open);
    hit.setAttribute('aria-expanded', String(open));
    hit.href = open ? base : card.dataset.href!;
    document.getElementById(hit.getAttribute('aria-controls')!)!.hidden = !open;
    if (open) delete card.dataset.pill;
    else if (card.dataset.pillClosed) card.dataset.pill = card.dataset.pillClosed;
  };

  // Takeover starts at the top row; on phones, bring the card's top to the gutter line.
  const bringIntoView = (card: HTMLElement, behavior: ScrollBehavior = 'instant') => {
    if (wide.matches) return window.scrollTo({ top: 0, behavior });
    const line = parseFloat(getComputedStyle(grid).paddingTop) || 16;
    window.scrollBy({ top: card.getBoundingClientRect().top - line, behavior });
  };

  /** The card being closed from inside it; its title gets focus back. */
  let refocus: HTMLElement | undefined;

  /** Show a card open (or none), then scroll to a saved position or to a card. */
  const show = (card: HTMLElement | undefined, { animate = true, to }: { animate?: boolean; to?: number | HTMLElement } = {}) => {
    const was = openCard();
    const update = () => {
      for (const c of cards) if (c !== card && c.classList.contains('is-open')) setOpen(c, false);
      if (card) setOpen(card, true);
      grid.classList.toggle('has-open', !!card);
      document.title = (card ?? grid).dataset.pageTitle ?? document.title;
      if (typeof to === 'number') window.scrollTo({ top: to, behavior: 'instant' });
      else if (to) bringIntoView(to);
      // Closed from inside the card (its Back pill, its title, Escape), or with focus inside it:
      // focus goes back to its title.
      if (was && was !== card && (was === refocus || was.contains(document.activeElement))) was.querySelector<HTMLElement>('.box-hit')?.focus({ preventScroll: true });
      refocus = undefined;
    };
    if (animate && !reduced && 'startViewTransition' in document) document.startViewTransition(update);
    else update();
    document.dispatchEvent(new CustomEvent('pill:clear'));
  };

  const open = (card: HTMLElement) => {
    // From the grid, a new entry; from another open card (phones), swap entries so Back still
    // lands on the grid.
    const switching = !!openCard();
    remember();
    const entry: Entry = { site: 1, open: card.dataset.section!, back: switching ? !!state().back : true };
    if (switching) history.replaceState(entry, '', urlOf(card));
    else history.pushState(entry, '', urlOf(card));
    show(card, { to: card });
  };

  const close = () => {
    const card = openCard();
    if (!card) return;
    refocus = card;
    if (state().back) return history.back(); // popstate closes it
    history.pushState({ site: 1, open: null } satisfies Entry, '', urlOf());
    show(undefined, { to: wide.matches ? 0 : card });
  };

  for (const card of cards) {
    card.querySelector('.box-hit')!.addEventListener('click', (e) => {
      const m = e as MouseEvent;
      // New-tab and new-window clicks load the section's own page (or the grid).
      if (m.button !== 0 || m.metaKey || m.ctrlKey || m.shiftKey || m.altKey) return;
      e.preventDefault();
      if (card.classList.contains('is-open')) close();
      else open(card);
    });
    card.querySelector('.box-back')!.addEventListener('click', (e) => {
      const m = e as MouseEvent;
      if (m.button !== 0 || m.metaKey || m.ctrlKey || m.shiftKey || m.altKey) return;
      e.preventDefault();
      close();
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });

  // Back and Forward between the grid and an open card.
  const fromHash = () => cards.find((c) => `#${c.dataset.section}` === location.hash);
  window.addEventListener('popstate', () => {
    if (fromHash()) return; // an old hash link (below)
    const card = cardAt(location.pathname);
    const was = openCard();
    if (card === was) return;
    show(card, { to: card ?? state().y ?? was });
  });

  // This page's own entry: what's open, keeping what a reload carried over.
  history.replaceState({ ...state(), site: 1, open: openCard()?.dataset.section ?? null } satisfies Entry, '');
  const navType = (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type;
  const savedY = navType === 'back_forward' || navType === 'reload' ? state().y : undefined;
  let userScrolled = false;
  for (const t of ['wheel', 'touchstart', 'keydown'] as const) addEventListener(t, () => (userScrolled = true), { once: true, passive: true });
  if (savedY) window.scrollTo({ top: savedY, behavior: 'instant' });

  // Old hash links (/site/#portfolio, #techniques) still open their card, and move to its URL.
  // A section's own page arrives with its card open. On phones the scroll to it waits for the
  // entrance, since the hero is still opening above it.
  const hashed = fromHash();
  if (hashed) {
    history.replaceState({ site: 1, open: hashed.dataset.section! } satisfies Entry, '', urlOf(hashed));
    show(hashed, { animate: false, to: wide.matches ? hashed : undefined });
  }
  const linked = openCard();
  window.addEventListener('hashchange', () => {
    const card = fromHash();
    if (!card || card === openCard()) return;
    history.replaceState({ site: 1, open: card.dataset.section!, back: false } satisfies Entry, '', urlOf(card));
    show(card, { to: card });
  });

  // ── Entrance (lib/site-shell.ts) ────────────────────
  runEntrance(() => {
    // A reload or a Back that reloaded: the saved position again, now the hero has opened.
    if (savedY) return userScrolled || window.scrollTo({ top: savedY, behavior: 'instant' });
    const quiet = reduced || document.documentElement.classList.contains('from-site');
    if (linked && !wide.matches && openCard() === linked) bringIntoView(linked, quiet ? 'instant' : 'smooth');
  });
</script>
