---
// A closer look at one piece of work: the public, ungated version of a case study. Techniques
// articles use the same shell (pages/site/techniques/[slug].astro). It's a page
// of its own (/site/work/<slug>/) in the site's shell: the hero (with the site's menu) stays on the
// left and the work fills the right two columns, like an open card. A Back link at the top
// (Bohdana) returns to Selected work, the home: through history when that's where the visitor came
// from (scroll and state come back as they were), otherwise as a plain link. Escape does the same.
// Arriving from the home shows the page at once and keeps the scene running (SiteHead), and the
// home's white work page morphs into this card (shared view-transition name box-portfolio).
// Case studies go full screen as the visitor scrolls (styles/home.css).
// What belongs on these pages: the problem in public terms, my role, the key decisions with their
// artifacts, what shipped and what I learned, plus at most the one public-safe result line from
// the facts sheet. Call-only numbers, internal tools and colleagues' details stay off.
import '../../styles/site.css';
import '../../styles/home.css';
import Base from '../../layouts/Base.astro';
import Pill from '../Pill.astro';
import DisplaySettings from './DisplaySettings.astro';
import ShapeField from '../ShapeField.astro';
import SiteCard from './SiteCard.astro';
import SiteFoot from './SiteFoot.astro';
import SiteHead from './SiteHead.astro';
import { defaultPreset } from '../../lib/presets';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import JsonLd from '../JsonLd.astro';
import { article, breadcrumbs, graph, person, website } from '../../lib/schema';
import { SITE_BASE, SITE_LIVE, SITE_ORIGIN } from '../../lib/site-sections';

interface Props {
  title: string;
  /** Shown under the title. */
  subtitle: string;
  /** Company name; the eyebrow reads "<company> · A closer look". */
  company?: string;
  /** Overrides the eyebrow (Techniques articles: "Techniques"). */
  eyebrow?: string;
  /** The open card this page morphs out of: box-portfolio for case studies, box-techniques for articles. */
  transition?: string;
  /** What this page is, for structured data: a case study or Techniques article (an Article with
   *  breadcrumbs), or a plain page (the 404) with no article data. */
  kind?: 'article' | 'page';
  /** A Markdown version of this page (Techniques articles), linked for agents. */
  markdown?: string;
  pageTitle: string;
  description: string;
  accent: string;
  backHref: string;
  backLabel: string;
}
const { title, subtitle, company, eyebrow = `${company} · A closer look`, transition = 'box-portfolio', pageTitle, description, accent, backHref, backLabel, kind = 'article', markdown } = Astro.props;
// Case studies go full screen as the visitor scrolls (Andy, Nov 16; after luzcas.com/batch).
const canFull = kind === 'article' && transition === 'box-portfolio';
// The hero menu's current row: Selected work for case studies, Techniques for articles, none for
// plain pages (the colophon, the 404).
const menuCurrent = kind !== 'article' ? null : transition === 'box-techniques' ? 'techniques' : 'work';

// Share image: public/site/og/<section>-<slug>.jpg, made by `npm run og:pages`; the default if none.
const path = Astro.url.pathname;
const ogName = path.replace(SITE_BASE, '').replace(/\/$/, '').replace(/\//g, '-');
const ogSrc = `/site/og/${ogName}.jpg`;
const image = kind === 'article' && existsSync(join(process.cwd(), 'public', ogSrc)) ? { src: ogSrc, width: 1200, height: 630, alt: `${title}: ${subtitle}` } : undefined;
const schema =
  kind === 'article'
    ? graph(person(), website(), article({ path, title, subtitle, description, image: image?.src, company, section: backLabel }), breadcrumbs([{ name: backLabel, path: backHref }, { name: title }]))
    : graph(person(), website());
---

<Base title={pageTitle} description={description} preset={defaultPreset} origin={SITE_ORIGIN} ogType={kind === 'article' ? 'article' : 'website'} image={image} noindex={!SITE_LIVE}>
  <Fragment slot="head">
    <SiteHead />
    <JsonLd data={schema} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title={`${title} (Markdown)`} />}
  </Fragment>

  <a class="skip" href="#content">Skip to content</a>
  <ShapeField preset={defaultPreset} eager />

  <main class:list={['site has-open is-inner', { 'can-full': canFull }]}>
    <SiteCard nameAs="p" current={menuCurrent} fold />
    <article class="card box is-open is-takeover look" id="content" tabindex="-1" style={`--accent:${accent};--b:0;view-transition-name:${transition}`} aria-labelledby="look-title">
      <div class="look-bar">
        <a class="backlink" href={backHref} data-back aria-label={`Back to ${backLabel}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M11 6l-6 6 6 6" />
          </svg>
          Back
        </a>
        {canFull && (
          <button class="look-full" type="button" aria-pressed="false" aria-label="Full screen" data-full-toggle>
            <svg class="i-grow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
            </svg>
            <svg class="i-shrink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" />
            </svg>
          </button>
        )}
      </div>
      <div class="box-top">
        <p class="eyebrow">{eyebrow}</p>
      </div>
      <header class="look-head">
        <h1 class="box-title" id="look-title">{title}</h1>
        <p class="look-sub">{subtitle}</p>
      </header>
      <div class="look-body">
        <slot />
      </div>
    </article>
  </main>
  <SiteFoot />

  <Pill />
  <DisplaySettings />
</Base>

<script>
  import { rememberScene, runEntrance, watchHeroHeight } from '../../lib/site-shell';

  rememberScene();
  watchHeroHeight(document.querySelector<HTMLElement>('.site')!);
  runEntrance();

  // Back: if the visitor came from the page Back points to, step back through history, so it
  // returns exactly as they left it (often instantly, from the back/forward cache). Otherwise
  // (a direct visit, a shared link) it's a normal link. New-tab clicks are left alone.
  const link = document.querySelector<HTMLAnchorElement>('.backlink');
  const cameFromBack = () => {
    try {
      const ref = new URL(document.referrer);
      return !!link && ref.origin === location.origin && ref.pathname === new URL(link.href).pathname && history.length > 1;
    } catch {
      return false;
    }
  };
  const goBack = () => (cameFromBack() ? history.back() : link && location.assign(link.href));
  link?.addEventListener('click', (e) => {
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    goBack();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') goBack();
  });

  // ── Full screen on scroll (after luzcas.com/batch) ──
  // Past the first few pixels of scroll the hero steps out and the card takes the whole width;
  // back at the top it returns. The switch beside Back overrides it until the visitor scrolls
  // back to the top. Tablet and up, case studies only.
  const site = document.querySelector<HTMLElement>('.site.can-full');
  const toggle = document.querySelector<HTMLButtonElement>('[data-full-toggle]');
  if (site && toggle) {
    const wide = matchMedia('(min-width: 760px)');
    const ENTER = 48;
    const TOP = 4;
    let manual: boolean | null = null;
    const enabled = () => wide.matches;
    const set = (on: boolean) => {
      if (site.classList.contains('is-full') === on) return;
      site.classList.toggle('is-full', on);
      toggle.setAttribute('aria-pressed', String(on));
      toggle.setAttribute('aria-label', on ? 'Exit full screen' : 'Full screen');
      document.dispatchEvent(new CustomEvent('pill:clear'));
    };
    const update = () => {
      if (!enabled()) return set(false);
      const y = window.scrollY;
      if (y <= TOP && manual !== true) manual = null;
      const auto = site.classList.contains('is-full') ? y > TOP : y > ENTER;
      set(manual ?? auto);
    };
    toggle.addEventListener('click', () => {
      manual = !site.classList.contains('is-full');
      set(manual);
    });
    addEventListener('scroll', () => {
      if (manual === true && window.scrollY > TOP) return;
      if (manual !== null && window.scrollY <= TOP) manual = null;
      update();
    }, { passive: true });
    wide.addEventListener('change', update);
    update();
  }
</script>
