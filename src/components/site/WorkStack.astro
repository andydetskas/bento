---
// The Selected work card's art (Andy, Nov 11; it replaced the 2 × 2 thumbnails): a stack of
// cards, one in front at a time. The front one drops off the bottom and the stack steps forward.
// Each card is one of Andy's compositions: a piece of the work on the brand's color, with the
// logo in the lower right. He draws them in 2026 Portfolio › Case Studies › "Selected work stack
// cards (for the coded site)" (4173:6580), 800 × 500 with rounded top corners; each frame is
// exported as public/site/work/stack/<id>.webp, in his order (rows, left to right). `color` is
// the frame's fill, shown behind the image's transparent corners and while it loads.
// With motion off (system or Display settings) it's a still stack of the first three.
import { SITE_BASE } from '../../lib/site-sections';

const cards = [
  { id: 'suppco', alt: 'SuppCo, part of Function Health: the SuppScore screen', color: '#B5562F' },
  { id: 'strava', alt: 'Strava: Local Legend on web and phone', color: '#FC4C02' },
  { id: 'sram', alt: 'SRAM: a suspension fork’s setup page', color: '#E51937' },
  { id: 'united', alt: 'United Airlines, with Pivotal Labs: a bag-transfer scanner in hand', color: '#005DAA' },
  { id: 'allstate-arity', alt: 'Allstate and Arity: the Drivewise vehicle list', color: '#173C79' },
  // Held back (Nov 11): the photo in this card carries iStock watermarks. Add it back once the
  // image is replaced.
  // { id: 'intuit', alt: 'Intuit: the TurboTax mobile home page', color: '#236CFF' },
];
const posOf = (i: number) => (i < 3 ? String(i) : 'back');
---

<ul class="stack" role="list" aria-label="Companies I’ve worked with" data-stack>
  {
    cards.map((c, i) => (
      <li class="stack-card" data-pos={posOf(i)} style={`--tint:${c.color}`}>
        <img src={`${SITE_BASE}work/stack/${c.id}.webp`} width="800" height="500" alt={c.alt} loading="eager" fetchpriority="low" />
      </li>
    ))
  }
</ul>

<script>
  import { motionReduced } from '../../lib/display-settings';

  const stack = document.querySelector<HTMLElement>('[data-stack]');
  if (stack) {
    const cards = [...stack.querySelectorAll<HTMLElement>('.stack-card')];
    const n = cards.length;
    let front = 0;
    const place = () =>
      cards.forEach((c, i) => {
        const p = (i - front + n) % n;
        c.dataset.pos = p < 3 ? String(p) : p === n - 1 ? 'out' : 'back';
      });
    // One step every 2.6 s, only while the card is closed, on screen and motion is on.
    let seen = true;
    new IntersectionObserver(([e]) => (seen = e.isIntersecting)).observe(stack);
    setInterval(() => {
      if (!seen || document.hidden || motionReduced() || stack.closest('.is-open')) return;
      front = (front + 1) % n;
      place();
    }, 2600);
  }
</script>

<style>
  /* The footprint of the 2 × 2 thumbnails it replaced. Cards sit on the bottom edge; the two behind the
     front one show their top edges above it. */
  .stack {
    position: relative;
    aspect-ratio: 4 / 3;
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
    border-radius: var(--space-2);
  }
  .stack-card {
    position: absolute;
    left: 5%;
    bottom: 0;
    width: 90%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--space-3) var(--space-3) 0 0;
    background: var(--tint);
    box-shadow: 0 -1px 0 rgb(0 0 0 / 0.04), 0 -8px 24px -12px rgb(0 0 0 / 0.25);
    transform-origin: 50% 0;
    /* Waiting at the back, out of sight. */
    opacity: 0;
    transform: translateY(-40%) scale(0.76);
    transition:
      transform var(--motion-settle) var(--motion-ease-settle),
      opacity 500ms var(--motion-ease-standard);
  }
  .stack-card[data-pos='0'] {
    z-index: 3;
    opacity: 1;
    transform: none;
  }
  .stack-card[data-pos='1'] {
    z-index: 2;
    opacity: 1;
    transform: translateY(-15%) scale(0.92);
  }
  .stack-card[data-pos='2'] {
    z-index: 1;
    opacity: 1;
    transform: translateY(-29%) scale(0.84);
  }
  /* The one that just left: it drops off the bottom edge. */
  .stack-card[data-pos='out'] {
    z-index: 4;
    opacity: 0;
    transform: translateY(70%);
    transition:
      transform 620ms cubic-bezier(0.5, 0, 0.9, 0.4),
      opacity 300ms linear 320ms;
  }
  .stack-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
