---
// The calling card: profile header + link rows. Content comes from src/content/links.json.
import data from '../content/links.json';
import { tokens } from '../lib/tokens';
import Icon from './Icon.astro';

interface Props {
  showIcons?: boolean;
}
const { showIcons = true } = Astro.props;
const { profile, links } = data;
const accents = tokens.accent as Record<string, string>;
let line = 0; // stagger index: lines land 60ms apart
---

<main class="frame">
  <section class="card" aria-label={`${profile.name}, links`}>
    <header class="card-head">
      <Icon name={profile.mark} class="mark" />
      <div class="who">
        <h1 class="name line trim-sans"><span class="line-inner" style={`--i:${line++}`}>{profile.name}</span></h1>
        <p class="role line trim-mono"><span class="line-inner" style={`--i:${line++}`}>{profile.role}</span></p>
      </div>
    </header>

    <ul class="rows" role="list">
      {
        links.map((link) => (
          <li>
            <a
              class="row"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              data-accent={accents[link.id]}
              data-tooltip={link.tooltip}
              style={`--accent:${accents[link.id]}`}
            >
              <span class="row-text">
                <span class="eyebrow line trim-mono">
                  <span class="line-inner" style={`--i:${line++}`}>
                    {showIcons && <Icon name={link.icon} class="row-icon" />}
                    {link.eyebrow}
                  </span>
                </span>
                <span class="label line trim-sans">
                  <span class="line-inner" style={`--i:${line++}`}>{link.label}</span>
                </span>
              </span>
              <span class="row-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 17 17 7M9 7h8v8" />
                </svg>
              </span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</main>

<div class="pill" aria-hidden="true"></div>

<style>
  .frame {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    padding: var(--gutter);
    display: flex;
    align-items: flex-start;
  }

  .card {
    width: min(100%, var(--card-w));
    display: flex;
    flex-direction: column;
    /* Card hugs its content: masthead, a fixed gap, then the table. */
    gap: var(--space-6);
    /* All spacing snaps to the 4px baseline unit. */
    --pad: clamp(20px, round(2.6vw, 4px), 36px);
    padding: var(--pad) var(--pad) clamp(12px, round(1.6vw, 4px), 20px);
    background: var(--color-card);
    color: var(--color-text-primary);
    border-radius: var(--card-radius);
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.03),
      0 40px 90px -50px rgb(20 20 30 / 0.45);
    transition:
      background-color var(--motion-base) var(--motion-ease-standard),
      border-radius var(--motion-base) var(--motion-ease-standard);
  }

  /* ── Header ─────────────────────────────────────────── */
  /* Type is trimmed to cap height and baseline (see .trim-* in global.css), and every cap
     height is a multiple of 4px, so the mark can match the text block exactly. */
  .card-head {
    --name-cap: round(var(--type-title) * var(--cap-sans), var(--bl));
    --role-cap: 8px;
    --who-gap: var(--space-2);
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }
  /* The globe runs from the name's cap height to the role's baseline. The script below
     re-measures if the role wraps onto a second line. */
  .card-head :global(.mark) {
    height: calc(var(--name-cap) + var(--who-gap) + var(--role-cap));
    aspect-ratio: 918 / 862;
    flex: none;
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: var(--who-gap);
    min-width: 0;
  }
  .name {
    --cap: var(--name-cap);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-title);
  }
  .role {
    --cap: var(--role-cap);
    --lh: var(--leading-eyebrow);
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ── Rows ───────────────────────────────────────────── */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* The 1px hairline comes out of the padding so rows stay on the 4px rhythm. */
  .rows li + li .row {
    border-top: 1px solid var(--color-line);
    padding-top: calc(var(--row-pt) - 1px);
  }
  .row {
    /* Label size follows the viewport height so six rows fit; its cap height snaps to 4px.
       Padding scales with the label: room above the eyebrow, more below for descenders. */
    --fz: min(var(--type-display), 6.2svh);
    --label-cap: round(var(--fz) * var(--cap-sans), var(--bl));
    --row-pt: round(up, var(--label-cap) * 0.5, var(--bl));
    --row-pb: round(up, var(--label-cap) * 0.6, var(--bl));
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--row-pt) 0 var(--row-pb);
    color: inherit;
    text-decoration: none;
    outline: none;
    transition: opacity var(--motion-base) var(--motion-ease-standard);
  }
  .row-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }
  .eyebrow {
    --cap: 8px;
    --lh: var(--leading-eyebrow);
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  /* Top-aligned so the 16px icon fills the 16px line instead of sitting on the baseline
     and growing it, which would break the trim math. */
  .eyebrow .line-inner {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    vertical-align: top;
  }
  .eyebrow :global(.row-icon) {
    width: 16px;
    height: 16px;
    color: var(--color-text-primary);
    transition: color var(--motion-quick) var(--motion-ease-standard);
  }
  .label {
    --cap: var(--label-cap);
    --lh: var(--leading-display);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
  }

  .row-arrow {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    display: grid;
    place-items: center;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity var(--motion-base) var(--motion-ease-settle),
      transform var(--motion-base) var(--motion-ease-settle),
      background-color var(--motion-quick) var(--motion-ease-standard),
      border-color var(--motion-quick) var(--motion-ease-standard);
  }
  .row-arrow svg {
    width: 18px;
    height: 18px;
  }

  /* Focus mode: the hovered (or keyboard-focused) row stays, the others step back.
     Hover only where there's a real pointer: a tap leaves :hover stuck on phones, which kept
     five rows faded when a visitor came back to the page. */
  .rows:has(.row:focus-visible) .row:not(:focus-visible) {
    opacity: 0.28;
  }
  .row:focus-visible .row-arrow {
    opacity: 1;
    transform: none;
    background: var(--accent);
    border-color: var(--accent);
    color: var(--color-pill-text);
  }
  .row:focus-visible :global(.row-icon) {
    color: var(--accent);
  }
  @media (hover: hover) {
    .rows:has(.row:hover) .row:not(:hover) {
      opacity: 0.28;
    }
    .row:hover .row-arrow {
      opacity: 1;
      transform: none;
      background: var(--accent);
      border-color: var(--accent);
      color: var(--color-pill-text);
    }
    .row:hover :global(.row-icon) {
      color: var(--accent);
    }
  }
  .row:focus-visible .label {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
    text-decoration-color: var(--color-focus);
  }

  /* Touch: no hover, so the arrow is always there. */
  @media (hover: none) {
    .row-arrow {
      opacity: 1;
      transform: none;
    }
  }

  /* ── Load: lines land 60ms apart, the card never moves ─ */
  /* Each line is its own mask. --trim-pad keeps ascenders and descenders inside it
     without changing the trimmed layout. */
  .line {
    display: block;
    overflow: hidden;
    --trim-pad: 0.25em;
  }
  .line-inner {
    display: inline-block;
  }
  :global(html.js) .line-inner {
    transform: translateY(calc(100% + 0.5em));
    transition: transform var(--motion-settle) var(--motion-ease-settle);
    transition-delay: calc(var(--i) * var(--motion-stagger) + 120ms);
  }
  :global(html.js.is-ready) .line-inner {
    transform: none;
  }

  /* ── Cursor pill ────────────────────────────────────── */
  .pill {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 10;
    pointer-events: none;
    padding: 7px 12px;
    border-radius: var(--radius-pill);
    background: var(--pill-bg, #fff);
    color: var(--color-pill-text);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: var(--weight-mono);
    letter-spacing: 0.02em;
    white-space: nowrap;
    opacity: 0;
    scale: 0.85;
    transition:
      opacity var(--motion-quick) var(--motion-ease-standard),
      scale var(--motion-base) var(--motion-ease-settle),
      background-color var(--motion-quick) var(--motion-ease-standard);
  }
  .pill.is-on {
    opacity: 1;
    scale: 1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── Small screens: scene on top, card below ─────────── */
  /* Phones: the card centers vertically (the frame grows instead if the card is taller than
     the screen). Row type follows the width but is capped by height, like desktop, so the
     card still fits in short in-app browsers (Instagram, LinkedIn). */
  @media (max-width: 759px) {
    .frame {
      align-items: center;
    }
    .card {
      width: 100%;
    }
    .row {
      --fz: min(clamp(2.25rem, 11.5vw, 3.25rem), 6.2svh);
    }
    .row-arrow {
      width: 40px;
      height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .line-inner {
      transform: none;
      transition: none;
    }
    .row,
    .row-arrow,
    .pill {
      transition: none;
    }
  }
</style>

<script>
  // Globe height = name cap height → role baseline, re-measured if the role wraps.
  const who = document.querySelector<HTMLElement>('.who');
  const mark = document.querySelector<HTMLElement>('.card-head .mark');
  if (who && mark) {
    const fitMark = () => (mark.style.height = `${who.getBoundingClientRect().height}px`);
    fitMark();
    document.fonts?.ready.then(fitMark);
    window.addEventListener('resize', fitMark, { passive: true });
    new ResizeObserver(fitMark).observe(who);
  }

  const pill = document.querySelector<HTMLElement>('.pill');
  const rows = document.querySelectorAll<HTMLAnchorElement>('.row');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const accent = (hex: string | null) => document.dispatchEvent(new CustomEvent('bento:accent', { detail: { hex } }));

  // Cursor pill: eased follow so it trails the pointer slightly.
  let x = 0, y = 0, tx = 0, ty = 0, raf = 0;
  const follow = () => {
    x += (tx - x) * (reduced ? 1 : 0.22);
    y += (ty - y) * (reduced ? 1 : 0.22);
    if (pill) pill.style.translate = `${x + 16}px ${y + 18}px`;
    raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(follow) : 0;
  };
  const move = (e: PointerEvent) => {
    tx = e.clientX;
    ty = e.clientY;
    if (!raf) raf = requestAnimationFrame(follow);
  };

  // Touch gets no tooltip and no scene tint: a tap is a click, not a hover.
  rows.forEach((row) => {
    row.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'touch') return;
      accent(row.dataset.accent ?? null);
      if (!finePointer || !pill) return;
      pill.textContent = row.dataset.tooltip ?? '';
      pill.style.setProperty('--pill-bg', row.dataset.accent ?? '#fff');
      if (!pill.classList.contains('is-on')) {
        x = tx = e.clientX;
        y = ty = e.clientY;
        follow();
      }
      pill.classList.add('is-on');
    });
    row.addEventListener('pointermove', move);
    row.addEventListener('pointerleave', () => {
      accent(null);
      pill?.classList.remove('is-on');
    });
    // Keyboard focus mirrors hover; the focus a tap gives a link doesn't.
    row.addEventListener('focus', () => row.matches(':focus-visible') && accent(row.dataset.accent ?? null));
    row.addEventListener('blur', () => accent(null));
  });

  // Start the line reveal once fonts are in (avoids a reflow mid-animation).
  const ready = () => requestAnimationFrame(() => document.documentElement.classList.add('is-ready'));
  if (document.fonts?.ready) document.fonts.ready.then(ready);
  else ready();
</script>
