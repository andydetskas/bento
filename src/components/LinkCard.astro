---
// The calling card: profile header + link rows. Content comes from src/content/links.json.
// A link with "handoff": true (Portfolio) opens the main site in the same tab, behind an exit
// that hands the card over to the site's own card (see src/lib/handoff.ts).
import data from '../content/links.json';
import { MAIN_URL } from '../lib/handoff';
import { tokens } from '../lib/tokens';
import CardHead from './CardHead.astro';
import Icon from './Icon.astro';
import Pill from './Pill.astro';

interface Props {
  showIcons?: boolean;
}
const { showIcons = true } = Astro.props;
const { profile, links } = data;
const accents = tokens.accent as Record<string, string>;
let line = 2; // stagger index: lines land 60ms apart (the masthead takes 0 and 1)
---

<main class="frame">
  <section class="card" aria-label={`${profile.name}, links`}>
    <CardHead />

    <ul class="rows" role="list">
      {
        links.map((link, n) => {
          const handoff = 'handoff' in link && link.handoff;
          return (
            <li style={`--n:${n}`}>
              <a
                class="row"
                href={handoff ? MAIN_URL : link.url}
                target={handoff ? undefined : '_blank'}
                rel={handoff ? undefined : 'noopener noreferrer'}
                data-handoff={handoff ? '' : undefined}
                data-accent={accents[link.id]}
                data-pill={link.tooltip}
                style={`--accent:${accents[link.id]}`}
              >
                <span class="row-text">
                  <span class="eyebrow line trim-mono">
                    <span class="line-inner" style={`--i:${line++}`}>
                      {showIcons && <Icon name={link.icon} class="row-icon" />}
                      {link.eyebrow}
                    </span>
                  </span>
                  <span class="label line trim-sans">
                    <span class="line-inner" style={`--i:${line++}`}>{link.label}</span>
                  </span>
                </span>
                <span class="row-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                </span>
                {!handoff && <span class="sr-only">(opens in a new tab)</span>}
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</main>

<Pill />

<style>
  .frame {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    padding: var(--gutter);
    display: flex;
    align-items: flex-start;
  }

  .card {
    width: min(100%, var(--card-w));
  }

  /* ── Rows ───────────────────────────────────────────── */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* The 1px hairline comes out of the padding so rows stay on the 4px rhythm. */
  .rows li + li .row {
    border-top: 1px solid var(--color-line);
    padding-top: calc(var(--row-pt) - 1px);
  }
  .row {
    /* Label size follows the viewport height so six rows fit; its cap height snaps to 4px.
       Padding scales with the label: room above the eyebrow, more below for descenders. */
    --fz: min(var(--type-display), 6.2svh);
    --label-cap: round(var(--fz) * var(--cap-sans), var(--bl));
    --row-pt: round(up, var(--label-cap) * 0.5, var(--bl));
    --row-pb: round(up, var(--label-cap) * 0.6, var(--bl));
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--row-pt) 0 var(--row-pb);
    color: inherit;
    text-decoration: none;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    transition: opacity var(--motion-base) var(--motion-ease-standard);
  }
  .row-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }
  .eyebrow {
    --cap: 8px;
    --lh: var(--leading-eyebrow);
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  /* Top-aligned so the 16px icon fills the 16px line instead of sitting on the baseline
     and growing it, which would break the trim math. */
  .eyebrow .line-inner {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    vertical-align: top;
  }
  .eyebrow :global(.row-icon) {
    width: 16px;
    height: 16px;
    color: var(--color-text-primary);
    transition: color var(--motion-quick) var(--motion-ease-standard);
  }
  .label {
    --cap: var(--label-cap);
    --lh: var(--leading-display);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
  }

  .row-arrow {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    display: grid;
    place-items: center;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity var(--motion-base) var(--motion-ease-settle),
      transform var(--motion-base) var(--motion-ease-settle),
      background-color var(--motion-quick) var(--motion-ease-standard),
      border-color var(--motion-quick) var(--motion-ease-standard);
  }
  .row-arrow svg {
    width: 18px;
    height: 18px;
  }

  /* Focus mode: the hovered (or keyboard-focused) row stays, the others step back.
     Hover only where there's a real pointer: a tap leaves :hover stuck on phones, which kept
     five rows faded when a visitor came back to the page. */
  .rows:has(.row:focus-visible) .row:not(:focus-visible) {
    opacity: 0.28;
  }
  .row:focus-visible .row-arrow {
    opacity: 1;
    transform: none;
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    color: var(--accent-on);
  }
  .row:focus-visible :global(.row-icon) {
    color: var(--accent);
  }
  @media (hover: hover) {
    .rows:has(.row:hover) .row:not(:hover) {
      opacity: 0.28;
    }
    .row:hover .row-arrow {
      opacity: 1;
      transform: none;
      background: var(--accent-fill);
      border-color: var(--accent-fill);
      color: var(--accent-on);
    }
    .row:hover :global(.row-icon) {
      color: var(--accent);
    }
  }
  .row:focus-visible .label {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
    text-decoration-color: var(--color-focus);
  }

  /* Touch: no hover, so the arrow is always there. */
  @media (hover: none) {
    .row-arrow {
      opacity: 1;
      transform: none;
    }
  }

  /* ── Hand-off exit (Portfolio) ──────────────────────── */
  /* The card folds up to its masthead at the top-left, the site card's first frame. The rows
     stay put while the card's bottom edge rises over them, each fading just before it's
     covered (bottom row first). The script pins the card's current top first, so on phones
     (where the card is centered) it slides up from where it was instead of jumping. */
  :global(html.is-leaving) .frame {
    align-items: flex-start;
  }
  /* ...and narrows to the site's first column (--site-col), where the hero card sits. */
  :global(html.is-leaving) .card {
    width: min(100%, var(--site-col));
    transition:
      margin-top var(--exit-ms) var(--motion-ease-standard),
      width var(--exit-ms) var(--motion-ease-standard);
  }
  :global(html.is-leaving) .rows {
    overflow: hidden;
    transition: height var(--exit-ms) var(--motion-ease-standard);
  }
  :global(html.is-leaving) .rows li {
    opacity: 0;
    transition: opacity calc(var(--exit-ms) * 0.45) var(--motion-ease-exit);
    transition-delay: calc((5 - var(--n)) * var(--exit-ms) * 0.09);
  }
  :global(html.is-leaving) .row {
    pointer-events: none;
  }
  /* The scene dissolves into the background color in the second half, because the site needs a
     moment to rebuild it. The site fades the same field back in, at the moment it left off. */
  :global(html.is-leaving .scene.is-live) {
    opacity: 0;
    transition: opacity calc(var(--exit-ms) * 0.6) var(--motion-ease-standard) calc(var(--exit-ms) * 0.4);
  }

  /* ── Small screens: scene on top, card below ─────────── */
  /* Phones: the card centers vertically (the frame grows instead if the card is taller than
     the screen). Row type follows the width but is capped by height, like desktop, so the
     card still fits in short in-app browsers (Instagram, LinkedIn). */
  @media (max-width: 759px) {
    .frame {
      align-items: center;
    }
    .card {
      width: 100%;
    }
    .row {
      --fz: min(clamp(2.25rem, 11.5vw, 3.25rem), 6.2svh);
    }
    .row-arrow {
      width: 40px;
      height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row,
    .row-arrow {
      transition: none;
    }
  }
</style>

<script>
  import { EXIT_MS, warmMainSite, writeHandoff } from '../lib/handoff';

  const root = document.documentElement;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Hand-off to the main site ───────────────────────
  // Warm the site's HTML as soon as a finger or button goes down, then play the exit while the
  // navigation is on its way. The bento stays on screen until the site paints.
  const card = document.querySelector<HTMLElement>('.frame .card');
  const rows = document.querySelector<HTMLElement>('.frame .rows');
  document.querySelectorAll<HTMLAnchorElement>('a[data-handoff]').forEach((a) => {
    a.addEventListener('pointerdown', () => warmMainSite(a.href), { once: true });
    a.addEventListener('click', (e) => {
      // Let new-tab and new-window clicks through untouched.
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      warmMainSite(a.href);
      const field = window.shapeField;
      writeHandoff({ t: field?.time ?? 0, preset: root.dataset.preset ?? '' });
      document.dispatchEvent(new CustomEvent('pill:clear'));
      if (reduced || !card || !rows) {
        location.assign(a.href);
        return;
      }
      // Pin the card where it is, switch the frame to top alignment, then let it slide up
      // while the rows collapse.
      const gutter = parseFloat(getComputedStyle(card.parentElement!).paddingTop);
      card.style.marginTop = `${card.getBoundingClientRect().top - gutter}px`;
      rows.style.height = `${rows.offsetHeight}px`;
      root.style.setProperty('--exit-ms', `${EXIT_MS}ms`);
      root.classList.add('is-leaving');
      card.offsetHeight; // commit the pinned state before animating from it
      requestAnimationFrame(() => {
        card.style.marginTop = '0px';
        rows.style.height = '0px';
      });
      setTimeout(() => location.assign(a.href), EXIT_MS);
    });
  });

  // Back button: the browser may restore this page exactly as it left (bfcache). Put it back.
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted || !root.classList.contains('is-leaving')) return;
    root.classList.remove('is-leaving');
    card?.style.removeProperty('margin-top');
    rows?.style.removeProperty('height');
  });

  // Start the line reveal once fonts are in (avoids a reflow mid-animation).
  const ready = () => requestAnimationFrame(() => root.classList.add('is-ready'));
  if (document.fonts?.ready) document.fonts.ready.then(ready);
  else ready();
</script>
