---
// Hover affordances shared by every page:
//   [data-pill="text"]   a cursor pill with that text follows the pointer (mouse and pen only)
//   [data-accent="#hex"] tints the scene toward that color while hovered or keyboard-focused,
//                        and colors the pill
// Nested targets work: entering a row inside a box shows the row's pill, leaving it brings the
// box's back. Touch gets neither: a tap is a click, not a hover.
// Change data-pill at any time and dispatch `pill:refresh` to update a pill that's showing.
---

<div class="pill" aria-hidden="true"></div>

<style>
  .pill {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 10;
    pointer-events: none;
    padding: 7px 12px;
    border-radius: var(--radius-pill);
    background: var(--accent-fill);
    color: var(--accent-on);
    font-family: var(--font-mono);
    font-size: calc(12px * var(--text-scale, 1));
    font-weight: var(--weight-mono);
    letter-spacing: 0.02em;
    white-space: nowrap;
    opacity: 0;
    scale: 0.85;
    transition:
      opacity var(--motion-quick) var(--motion-ease-standard),
      scale var(--motion-base) var(--motion-ease-settle),
      background-color var(--motion-quick) var(--motion-ease-standard);
  }
  .pill.is-on {
    opacity: 1;
    scale: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .pill {
      transition: none;
    }
  }
  /* After Back or Forward restores the page: no hovers until the mouse moves (see the script). */
  :global(html.hover-paused body) {
    pointer-events: none;
  }
</style>

<script>
  const pill = document.querySelector<HTMLElement>('.pill');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const accent = (hex: string | null) => document.dispatchEvent(new CustomEvent('bento:accent', { detail: { hex } }));

  // Cursor pill: eased follow so it trails the pointer slightly. A long pill that would run off
  // the right edge (a technique's one-line note) flips to the pointer's left.
  let x = 0, y = 0, tx = 0, ty = 0, raf = 0;
  const follow = () => {
    x += (tx - x) * (reduced ? 1 : 0.22);
    y += (ty - y) * (reduced ? 1 : 0.22);
    if (pill) {
      const w = pill.offsetWidth;
      const left = x + 16 + w > document.documentElement.clientWidth - 8 ? x - 12 - w : x + 16;
      pill.style.translate = `${left}px ${y + 18}px`;
    }
    raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(follow) : 0;
  };

  // Hovered targets, outermost first. The innermost one decides what shows.
  const stack: HTMLElement[] = [];
  const show = () => {
    const top = stack.at(-1);
    accent(stack.findLast((el) => el.dataset.accent)?.dataset.accent ?? null);
    const text = top?.dataset.pill;
    if (!pill || !finePointer || !top || !text) {
      pill?.classList.remove('is-on');
      return;
    }
    pill.textContent = text;
    pill.style.setProperty('--pill-bg', top.dataset.accent ?? '#fff');
    if (!pill.classList.contains('is-on')) {
      x = tx;
      y = ty;
      follow();
    }
    pill.classList.add('is-on');
  };

  document.addEventListener(
    'pointermove',
    (e) => {
      tx = e.clientX;
      ty = e.clientY;
      if (stack.length && !raf) raf = requestAnimationFrame(follow);
    },
    { passive: true },
  );
  document.addEventListener('pill:refresh', show);
  // A hand-off or an expanding panel can pull the target out from under the pointer.
  document.addEventListener('pill:clear', () => {
    stack.length = 0;
    show();
  });

  document.querySelectorAll<HTMLElement>('[data-pill], [data-accent]').forEach((el) => {
    el.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'touch') return;
      tx = e.clientX;
      ty = e.clientY;
      if (!stack.includes(el)) stack.push(el);
      show();
    });
    el.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'touch') return;
      const i = stack.indexOf(el);
      if (i >= 0) stack.splice(i);
      show();
    });
    // Keyboard focus mirrors hover for the scene tint; the focus a tap gives a link doesn't.
    el.addEventListener('focus', () => el.matches(':focus-visible') && el.dataset.accent && accent(el.dataset.accent));
    el.addEventListener('blur', () => accent(null));
  });

  // Back and Forward can restore the page exactly as it was left (the back/forward cache): mid-hover
  // on the link that was clicked. Chrome then replays that hover from the old pointer position
  // (pill, scene tint, hover styles), wherever the pointer really is now. So a restored page
  // starts with no hover, and hovers stay off until the mouse really moves (a replayed move has
  // no movement). A click, key or scroll turns them back on too. Touch never needed this.
  const resumeOn = ['pointermove', 'pointerdown', 'keydown', 'wheel'] as const;
  const resumeHover = (e: Event) => {
    if (e.type === 'pointermove' && !(e as PointerEvent).movementX && !(e as PointerEvent).movementY) return;
    document.documentElement.classList.remove('hover-paused');
    resumeOn.forEach((type) => window.removeEventListener(type, resumeHover, true));
  };
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    stack.length = 0;
    show();
    if (!finePointer) return;
    document.documentElement.classList.add('hover-paused');
    resumeOn.forEach((type) => window.addEventListener(type, resumeHover, { capture: true, passive: true }));
  });
</script>
