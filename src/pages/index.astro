---
import Base from '../layouts/Base.astro';
import LinkCard from '../components/LinkCard.astro';
import ShapeField from '../components/ShapeField.astro';
import { defaultPreset } from '../lib/presets';
import { MAIN_URL } from '../lib/handoff';

// Portfolio hand-off: open the connection to the main site now (every browser, including
// in-app ones), and let Chrome prefetch the page when a pointer settles on the link.
const mainOrigin = new URL(MAIN_URL).origin;
const speculation = JSON.stringify({ prefetch: [{ where: { href_matches: MAIN_URL }, eagerness: 'moderate' }] });
---

<Base
  title="Andy Detskas"
  shareTitle="Andy Detskas · Product Design Leadership and Execution"
  description="Hands-on design manager for products people have to trust. Portfolio, LinkedIn, Figma resources, photography, rides and playlists."
  preset={defaultPreset}
>
  <Fragment slot="head">
    <link rel="preconnect" href={mainOrigin} />
    <script type="speculationrules" set:html={speculation} />
  </Fragment>
  <ShapeField preset={defaultPreset} />
  <LinkCard />
</Base>

<script>
  // Review links: /?preset=ridgeline-color shows any concept without the lab panel;
  // /?palette=earth applies a named Glyphs palette; /?layout=checker a glyph layout.
  import { applyCardStyle } from '../lib/apply';
  import { defaultPreset, glyphPalettes, presets, type Preset } from '../lib/presets';

  const params = new URLSearchParams(location.search);
  const id = params.get('preset');
  const named = glyphPalettes.find((p) => p.id === params.get('palette'));
  let preset: Preset | undefined = (id && presets.find((p) => p.id === id)) || undefined;
  if (named) {
    const base = preset ?? defaultPreset;
    preset = { ...base, paletteId: named.id, palette: named.palette, card: { ...base.card, mode: named.mode } };
  }
  // /?layout=checker (or grid, scatter) previews a glyph layout.
  const layout = params.get('layout');
  if (layout === 'scatter' || layout === 'grid' || layout === 'checker') {
    const base = preset ?? defaultPreset;
    preset = { ...base, params: { ...base.params, layout } };
  }
  if (preset) {
    applyCardStyle(preset);
    document.dispatchEvent(new CustomEvent('bento:preset', { detail: { preset } }));
  }
</script>
