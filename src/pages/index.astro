---
import Base from '../layouts/Base.astro';
import LinkCard from '../components/LinkCard.astro';
import ShapeField from '../components/ShapeField.astro';
import { defaultPreset } from '../lib/presets';
---

<Base title="Andy Detskas" description="Andy Detskas — Product Design Leadership and Execution" preset={defaultPreset}>
  <ShapeField preset={defaultPreset} />
  <LinkCard />
</Base>

<script>
  // Review links: /?preset=ridgeline-color shows any concept without the lab panel;
  // /?palette=earth applies a named Glyphs palette.
  import { applyCardStyle } from '../lib/apply';
  import { defaultPreset, glyphPalettes, presets, type Preset } from '../lib/presets';

  const params = new URLSearchParams(location.search);
  const id = params.get('preset');
  const named = glyphPalettes.find((p) => p.id === params.get('palette'));
  let preset: Preset | undefined = (id && presets.find((p) => p.id === id)) || undefined;
  if (named) {
    const base = preset ?? defaultPreset;
    preset = { ...base, paletteId: named.id, palette: named.palette, card: { ...base.card, mode: named.mode } };
  }
  if (preset) {
    applyCardStyle(preset);
    document.dispatchEvent(new CustomEvent('bento:preset', { detail: { preset } }));
  }
</script>
