---
// Main site prototype (andydetskas.com, "full" treatment). Two rows of three cards over the
// bento's scene: hero, Portfolio, Leadership / Kit, Techniques, About. Opening Portfolio,
// Leadership, Techniques or About takes over the right two columns (Bohdana); the hero and the
// kit stay put. Lives at /site/ on the `site` branch; not linked or indexed.
import '../../styles/site.css';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import ShapeField from '../../components/ShapeField.astro';
import SectionCard from '../../components/site/SectionCard.astro';
import SiteCard from '../../components/site/SiteCard.astro';
import WorkTile from '../../components/site/WorkTile.astro';
import site from '../../content/site.json';
import { HANDOFF_COOKIE, HANDOFF_MAX_AGE_S } from '../../lib/handoff';
import { defaultPreset } from '../../lib/presets';
import { tokens } from '../../lib/tokens';

const { portfolio, leadership, work, kit, techniques, about } = site;
const accent = tokens.accent as Record<string, string>;
const light = tokens.taos.light as Record<string, Record<string, string>>;
const byId = (id: string) => work.find((w) => w.id === id)!;
const tintOf = (w: (typeof work)[number]) => light[w.tint[0]][w.tint[1]];
---

<Base
  title="Andy Detskas · Product Design"
  description="Hands-on design leadership for products people have to trust. Case studies, leadership, working kit, techniques and how to reach me."
  preset={defaultPreset}
  noindex
>
  <Fragment slot="head">
    {/* Before first paint: arriving from the bento? Then start from the bento's last frame. */}
    <script is:inline define:vars={{ name: HANDOFF_COOKIE, maxAge: HANDOFF_MAX_AGE_S }}>
      const m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
      if (m) {
        const domain = location.hostname.endsWith('andydetskas.com') ? '; Domain=andydetskas.com' : '';
        document.cookie = name + '=; Max-Age=0; Path=/; SameSite=Lax' + domain;
        try {
          const h = JSON.parse(decodeURIComponent(m[1]));
          if (h.v === 1 && Date.now() - h.at < maxAge * 1000) {
            window.__handoff = h;
            document.documentElement.classList.add('from-handoff');
          }
        } catch {}
      }
    </script>
  </Fragment>

  <ShapeField preset={defaultPreset} />

  <main class="site">
    <SiteCard />

    <SectionCard id="portfolio" eyebrow={portfolio.eyebrow} title={portfolio.title} accent={accent.portfolio} pill="See the work" index={0}>
      <Fragment slot="summary">
        <div class="mosaic" aria-hidden="true">
          {portfolio.preview.map((id) => {
            const w = byId(id);
            return (
              <span class="mosaic-cell" data-fit={w.fit} style={`--tint:${tintOf(w)}`}>
                <img src={w.image.src} width={w.image.width} height={w.image.height} alt="" loading="eager" decoding="async" />
              </span>
            );
          })}
        </div>
        <p class="box-body">{portfolio.lede}</p>
        <p class="meta">{work.length} case studies</p>
      </Fragment>
      <Fragment slot="panel">
        <p class="panel-lede">{portfolio.lede}</p>
        <div class="tiles">
          {work.map((w) => <WorkTile item={w} />)}
        </div>
      </Fragment>
    </SectionCard>

    <SectionCard id="leadership" eyebrow={leadership.eyebrow} title={leadership.title} accent={accent.leadership} pill="How I lead" index={1}>
      <Fragment slot="summary">
        <ul class="stats" role="list">
          {leadership.stats.map((s) => (
            <li>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </li>
          ))}
        </ul>
      </Fragment>
      <Fragment slot="panel">
        <p class="panel-lede">{leadership.lede}</p>
        <ul class="stats stats-row" role="list">
          {leadership.stats.map((s) => (
            <li>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </li>
          ))}
        </ul>
        <div class="groups">
          {leadership.groups.map((g) => (
            <section class="group">
              <header>
                <h3>{g.org}</h3>
                <p class="eyebrow">{g.role}</p>
              </header>
              <ul role="list">
                {g.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </section>
          ))}
        </div>
      </Fragment>
    </SectionCard>

    <SectionCard id="kit" eyebrow={kit.eyebrow} title={kit.title} index={2} expandable={false}>
      <Fragment slot="summary">
        <p class="box-body">{kit.lede}</p>
        <ul class="kit-tools" role="list">
          {kit.tools.map((t) => (
            <li>
              <strong>{t.name}</strong>
              <span>{t.note}</span>
            </li>
          ))}
        </ul>
      </Fragment>
    </SectionCard>

    <SectionCard id="techniques" eyebrow={techniques.eyebrow} title={techniques.title} accent={accent.techniques} pill="Read the techniques" index={3}>
      <Fragment slot="summary">
        <p class="box-body">{techniques.lede}</p>
        <ul class="post-list" role="list">
          {techniques.posts.map((p) => (
            <li>
              <Icon name={p.icon} />
              <span>{p.title}</span>
            </li>
          ))}
        </ul>
      </Fragment>
      <Fragment slot="panel">
        <p class="panel-lede">{techniques.lede}</p>
        <div class="tiles">
          {techniques.posts.map((p) => (
            <article class="tile">
              <div class="post-art">
                <img src={p.image} width="800" height="448" alt="" loading="lazy" decoding="async" />
              </div>
              <h3 class="tile-title">
                <a href={p.url} target="_blank" rel="noopener noreferrer" data-pill="Read the technique">
                  {p.title}
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </h3>
              <p class="box-body">{p.note}</p>
            </article>
          ))}
        </div>
        <a class="text-link" href={techniques.all} target="_blank" rel="noopener noreferrer">See all techniques</a>
      </Fragment>
    </SectionCard>

    <SectionCard id="about" eyebrow={about.eyebrow} title={about.title} accent={accent.about} pill="More about me" index={4}>
      <Fragment slot="summary">
        <p class="box-body">{about.body}</p>
      </Fragment>
      <Fragment slot="panel">
        <div class="about-panel">
          <p class="panel-lede">{about.body}</p>
          <p class="box-body">{about.more}</p>
          <ul class="roles" role="list">
            {about.experience.map((x) => (
              <li>
                <strong>{x.role}</strong>
                <span>{x.org}</span>
              </li>
            ))}
          </ul>
        </div>
      </Fragment>
    </SectionCard>
  </main>

  <Pill />
</Base>

<script>
  const root = document.documentElement;
  const grid = document.querySelector<HTMLElement>('.site')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = window.matchMedia('(min-width: 760px)');

  // ── Takeover ────────────────────────────────────────
  // One card open at a time. On tablet and desktop it takes over the work area and the other
  // work cards step out; on phones it opens in place. A same-document view transition moves
  // everything (browsers without it just switch). The URL hash follows (#portfolio etc.), so a
  // section can be linked to; replaceState, so Back still leaves the page.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-expandable]')];
  const openCard = () => cards.find((c) => c.classList.contains('is-open'));

  const setOpen = (card: HTMLElement, open: boolean) => {
    const hit = card.querySelector<HTMLButtonElement>('.box-hit')!;
    card.classList.toggle('is-open', open);
    hit.setAttribute('aria-expanded', String(open));
    document.getElementById(hit.getAttribute('aria-controls')!)!.hidden = !open;
    card.dataset.pillClosed ??= card.dataset.pill;
    if (open) delete card.dataset.pill;
    else card.dataset.pill = card.dataset.pillClosed;
  };

  // Takeover starts at the top row; on phones, bring the opened card's top to the gutter line.
  const bringIntoView = (card: HTMLElement, behavior: ScrollBehavior = 'instant') => {
    if (wide.matches) return window.scrollTo({ top: 0, behavior });
    const line = parseFloat(getComputedStyle(grid).paddingTop) || 16;
    window.scrollBy({ top: card.getBoundingClientRect().top - line, behavior });
  };

  const show = (card: HTMLElement | undefined, { animate = true, scroll = true } = {}) => {
    const update = () => {
      for (const c of cards) if (c !== card && c.classList.contains('is-open')) setOpen(c, false);
      if (card) setOpen(card, true);
      grid.classList.toggle('has-open', !!card);
      history.replaceState(null, '', card ? `#${card.dataset.section}` : location.pathname + location.search);
      if (card && scroll) bringIntoView(card);
    };
    if (animate && !reduced && 'startViewTransition' in document) document.startViewTransition(update);
    else update();
    document.dispatchEvent(new CustomEvent('pill:clear'));
  };

  for (const card of cards) {
    card.querySelector('.box-hit')!.addEventListener('click', () => show(card.classList.contains('is-open') ? undefined : card));
    card.querySelector('.box-close')!.addEventListener('click', () => {
      show(undefined);
      card.querySelector<HTMLElement>('.box-hit')?.focus();
    });
  }
  document.addEventListener('keydown', (e) => {
    const open = openCard();
    if (e.key !== 'Escape' || !open) return;
    show(undefined);
    open.querySelector<HTMLElement>('.box-hit')?.focus();
  });

  // Deep links: /#portfolio opens Portfolio on arrival, and an in-page link to #leadership
  // (or editing the hash) opens Leadership.
  const fromHash = () => cards.find((c) => `#${c.dataset.section}` === location.hash);
  // On arrival the hero is still opening above it, so on phones the scroll waits for the entrance.
  const linked = fromHash();
  if (linked) show(linked, { animate: false, scroll: wide.matches });
  window.addEventListener('hashchange', () => {
    const card = fromHash();
    if (card !== openCard()) show(card);
  });

  // ── Entrance ────────────────────────────────────────
  // Once fonts are in (or after a short wait on a slow connection): the hero opens below its
  // masthead and the other cards land around it.
  const ready = () =>
    requestAnimationFrame(() => {
      root.classList.add('is-ready');
      setTimeout(() => {
        root.classList.add('is-settled');
        if (linked && !wide.matches && openCard() === linked) bringIntoView(linked, reduced ? 'instant' : 'smooth');
      }, 1400);
    });
  const fontsIn = document.fonts?.ready ?? Promise.resolve();
  Promise.race([fontsIn, new Promise((r) => setTimeout(r, 400))]).then(ready);
</script>
