---
// Main site prototype (andydetskas.com, "full" treatment): the bento card on the left, the work
// as boxes over the same scene. Lives at /site/ on the `site` branch; not linked or indexed.
import '../../styles/site.css';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import ShapeField from '../../components/ShapeField.astro';
import SiteCard from '../../components/site/SiteCard.astro';
import WorkBox from '../../components/site/WorkBox.astro';
import site from '../../content/site.json';
import { HANDOFF_COOKIE, HANDOFF_MAX_AGE_S } from '../../lib/handoff';
import { defaultPreset } from '../../lib/presets';
import { tokens } from '../../lib/tokens';

const { work, kit, techniques, about, contact, intro } = site;
const byId = (id: string) => work.find((w) => w.id === id)!;
const contactAccent = (tokens.accent as Record<string, string>).contact;

// Order: work first, the rest interleaved so every screenful has some of both.
// (Order of the work follows the master profile's recommended /work order.)
let b = 0;
---

<Base
  title="Andy Detskas · Product Design"
  description="Hands-on design leadership for products people have to trust. Case studies, working kit, techniques and how to reach me."
  preset={defaultPreset}
  noindex
>
  <Fragment slot="head">
    {/* Before first paint: arriving from the bento? Then start from the bento's last frame. */}
    <script is:inline define:vars={{ name: HANDOFF_COOKIE, maxAge: HANDOFF_MAX_AGE_S }}>
      const m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
      if (m) {
        const domain = location.hostname.endsWith('andydetskas.com') ? '; Domain=andydetskas.com' : '';
        document.cookie = name + '=; Max-Age=0; Path=/; SameSite=Lax' + domain;
        try {
          const h = JSON.parse(decodeURIComponent(m[1]));
          if (h.v === 1 && Date.now() - h.at < maxAge * 1000) {
            window.__handoff = h;
            document.documentElement.classList.add('from-handoff');
          }
        } catch {}
      }
    </script>
  </Fragment>

  <ShapeField preset={defaultPreset} />

  <div class="site">
    <SiteCard />

    <main class="boxes" aria-label="Work and more">
      <WorkBox item={byId('designing-for-trust')} index={b++} />
      <WorkBox item={byId('agentic-design-system')} index={b++} />
      <WorkBox item={byId('surfacing-value')} index={b++} />

      <section class="card box is-wide is-neutral kit" aria-labelledby="kit-title" style={`--b:${b++};view-transition-name:box-kit`}>
        <div class="box-top"><p class="eyebrow">How I work</p></div>
        <h2 class="box-title" id="kit-title">{kit.title}</h2>
        <p class="box-body">{kit.lede}</p>
        <ul class="kit-tools" role="list">
          {kit.tools.map((t) => (
            <li>
              <strong>{t.name}</strong>
              <span>{t.note}</span>
            </li>
          ))}
        </ul>
      </section>

      <WorkBox item={byId('crushing-the-basics')} index={b++} />
      <WorkBox item={byId('stackscore')} index={b++} />

      <section class="card box is-wide is-neutral techniques" aria-labelledby="techniques-title" style={`--b:${b++};view-transition-name:box-techniques`}>
        <div class="box-top"><p class="eyebrow">Techniques</p></div>
        <h2 class="box-title" id="techniques-title">Pixels and people.</h2>
        <p class="box-body">{techniques.lede}</p>
        <ul class="posts" role="list">
          {techniques.posts.map((p) => (
            <li>
              <a class="post" href={p.url} target="_blank" rel="noopener noreferrer" data-pill="Read the technique">
                <Icon name={p.icon} />
                <span class="post-text">
                  <span class="post-title">{p.title}</span>
                  <span class="post-note">{p.note}</span>
                </span>
                <span class="arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8" /></svg>
                </span>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="text-link" href={techniques.all} target="_blank" rel="noopener noreferrer">See all techniques</a>
      </section>

      <WorkBox item={byId('buying-club')} index={b++} />
      <WorkBox item={byId('battery-ui')} index={b++} />

      <article class="card box is-neutral about" id="about" data-expandable data-pill="More about me" data-pill-open="Close" style={`--b:${b++};view-transition-name:box-about`}>
        <div class="box-top">
          <p class="eyebrow">About</p>
          <span class="arrow" aria-hidden="true">
            <svg class="i-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8" /></svg>
            <svg class="i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M7 7l10 10M17 7 7 17" /></svg>
          </span>
        </div>
        <h2 class="box-title">
          <button class="box-hit" type="button" aria-expanded="false" aria-controls="about-panel">{about.title}</button>
        </h2>
        <p class="box-body">{about.body}</p>
        <div class="about-panel" id="about-panel" hidden>
          <p>{about.more}</p>
          <ul class="roles" role="list">
            {about.experience.map((x) => (
              <li>
                <strong>{x.role}</strong>
                <span>{x.org}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>

      <WorkBox item={byId('call-and-response')} index={b++} />

      <section class="card box is-wide contact" aria-labelledby="contact-title" data-accent={contactAccent} style={`--accent:${contactAccent};--b:${b++};view-transition-name:box-contact`}>
        <div class="box-top"><p class="eyebrow">{intro.timezone}</p></div>
        <h2 class="contact-title" id="contact-title">{contact.title}</h2>
        <p class="box-body">{contact.body}</p>
        <div class="cta">
          <a class="btn" href={intro.cta.url} target="_blank" rel="noopener noreferrer" data-pill="Pick a time that works">
            {intro.cta.label}
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
      </section>
    </main>
  </div>

  <Pill />
</Base>

<script>
  const root = document.documentElement;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Open in place ───────────────────────────────────
  // One box open at a time. The box spans the work column; a same-document view transition
  // moves every box from its old spot to its new one (browsers without it just switch).
  const boxes = [...document.querySelectorAll<HTMLElement>('[data-expandable]')];

  const setOpen = (box: HTMLElement, open: boolean) => {
    const hit = box.querySelector<HTMLButtonElement>('.box-hit')!;
    const panel = document.getElementById(hit.getAttribute('aria-controls')!)!;
    box.classList.toggle('is-open', open);
    hit.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    box.dataset.pillClosed ??= box.dataset.pill;
    box.dataset.pill = open ? box.dataset.pillOpen : box.dataset.pillClosed;
  };

  const toggle = (box: HTMLElement) => {
    const opening = !box.classList.contains('is-open');
    const update = () => {
      for (const other of boxes) if (other !== box && other.classList.contains('is-open')) setOpen(other, false);
      setOpen(box, opening);
      if (!opening) return;
      // Bring the opened box's top in line with the card's (instantly; the transition animates the move).
      const line = parseFloat(getComputedStyle(document.querySelector('.site')!).paddingTop) || 16;
      const r = box.getBoundingClientRect();
      if (r.top < line || r.top > window.innerHeight * 0.5) window.scrollBy({ top: r.top - line, behavior: 'instant' });
    };
    if (!reduced && 'startViewTransition' in document) document.startViewTransition(update);
    else update();
    document.dispatchEvent(new CustomEvent('pill:refresh'));
  };

  for (const box of boxes) {
    box.querySelector('.box-hit')!.addEventListener('click', () => toggle(box));
  }
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = boxes.find((b) => b.classList.contains('is-open'));
    if (!open) return;
    toggle(open);
    open.querySelector<HTMLElement>('.box-hit')?.focus();
  });

  // ── Entrance ────────────────────────────────────────
  // Once fonts are in (or after a short wait on a slow connection): the card opens below its
  // masthead and the boxes land around it.
  const ready = () =>
    requestAnimationFrame(() => {
      root.classList.add('is-ready');
      setTimeout(() => root.classList.add('is-settled'), 1400);
    });
  const fontsIn = document.fonts?.ready ?? Promise.resolve();
  Promise.race([fontsIn, new Promise((r) => setTimeout(r, 400))]).then(ready);
</script>
