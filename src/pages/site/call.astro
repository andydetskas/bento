---
// "Schedule a call" lands here first and forwards to the booking calendar, so every click is a
// visit to /call/ in the site's analytics (Cloudflare Web Analytics after the cutover; no Google
// Analytics, Andy's call). The forward waits for the page to load so the analytics beacon gets out,
// with a meta refresh as a fallback and a plain link if both are blocked.
import site from '../../content/site.json';
const to = site.intro.cta.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Opening my calendar · Andy Detskas</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`2; url=${to}`} />
    <script is:inline define:vars={{ to }}>
      addEventListener('load', () => setTimeout(() => location.replace(to), 150));
    </script>
    <style>
      body { margin: 0; min-height: 100svh; display: grid; place-items: center; background: #f8e5d0; color: #343840; font: 16px/1.5 system-ui, sans-serif; }
      @media (prefers-color-scheme: dark) { body { background: #1f2226; color: #f8f5f3; } }
      a { color: inherit; }
    </style>
  </head>
  <body>
    <p>Opening my calendar… <a href={to}>Continue to scheduling</a></p>
  </body>
</html>
