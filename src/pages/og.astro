---
// Share image template, laid out at exactly 1200×630. `npm run og` captures it (at 2x) to
// public/og.png, which the Open Graph tags in Base.astro point to. Re-run it whenever the
// default preset, the profile or the links change.
import Base from '../layouts/Base.astro';
import ShapeField from '../components/ShapeField.astro';
import Icon from '../components/Icon.astro';
import data from '../content/links.json';
import { defaultPreset } from '../lib/presets';

const { profile, links } = data;
---

<Base title="Share image · Andy Detskas" description="Template for the share image" preset={defaultPreset} noindex>
  <ShapeField preset={defaultPreset} />
  <main class="og">
    <section class="card">
      <Icon name={profile.mark} class="mark" />
      <div class="who">
        <h1 class="name trim-sans">{profile.name}</h1>
        <p class="role trim-mono">{profile.role}</p>
      </div>
      <ul class="links" role="list">
        {
          links.map((link) => (
            <li class="link">
              <Icon name={link.icon} class="link-icon" />
              <span class="link-label trim-mono">{link.label}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Base>

<style>
  /* Every size here is a multiple of the 4px unit; cap heights drive the type (see .trim-*). */
  .og {
    position: fixed;
    inset: 0;
    z-index: 1;
    padding: 40px;
    display: flex;
  }
  .card {
    width: 640px;
    display: flex;
    flex-direction: column;
    padding: 48px;
    background: var(--color-card);
    color: var(--color-text-primary);
    border-radius: var(--card-radius);
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.03),
      0 40px 90px -50px rgb(20 20 30 / 0.45);
  }
  .card :global(.mark) {
    height: 80px;
    aspect-ratio: 918 / 862;
    align-self: flex-start;
    margin-bottom: 40px;
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .name {
    --cap: 64px;
    margin-inline: 0;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
  }
  .role,
  .link-label {
    --cap: 14px;
    margin-inline: 0;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    white-space: nowrap;
  }
  .role {
    color: var(--color-text-muted);
  }
  .links {
    list-style: none;
    margin: auto 0 0;
    padding: 32px 0 0;
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px 16px;
  }
  .link {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .link :global(.link-icon) {
    width: 20px;
    height: 20px;
    flex: none;
  }
</style>

<script>
  // The card covers the left half, so center the scene in the space to its right.
  document.addEventListener('shapefield:ready', (e) => e.detail.field.setFocus(0.3, 0));
</script>
